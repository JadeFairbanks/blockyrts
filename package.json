{
  "name": "blockyrts",
  "private": true,
  "description": "Survive and Conquer: a co-op browser RTS survival game.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "sim:run": "pnpm --filter @blockyrts/tools sim:run",
    "dev": "pnpm --filter @blockyrts/client dev",
    "assets:manifest": "pnpm --filter @blockyrts/tools assets:manifest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
