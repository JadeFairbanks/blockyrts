{
  "name": "@blockyrts/client",
  "version": "0.0.0",
  "private": true,
  "description": "The browser game: sim worker host, three.js renderer, HUD and input.",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @blockyrts/tools models:build",
    "dev": "vite",
    "prebuild": "pnpm --filter @blockyrts/tools models:build",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "art": "node scripts/make-art.mjs",
    "icons": "node scripts/make-icons.mjs",
    "shots": "node scripts/make-shots.mjs"
  },
  "dependencies": {
    "@blockyrts/audio": "workspace:*",
    "@blockyrts/balance": "workspace:*",
    "@blockyrts/protocol": "workspace:*",
    "@blockyrts/sim": "workspace:*",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "bcryptjs": "^3.0.3",
    "vite": "^7.3.0"
  }
}
