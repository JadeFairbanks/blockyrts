{
  "name": "@blockyrts/server",
  "version": "0.0.0",
  "private": true,
  "description": "The game server: accounts and save API, lobby and lockstep relay, in one Node.js process.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --outfile=dist/main.js --external:pg --external:ws --external:@node-rs/argon2 --external:@aws-sdk/client-s3",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "tsx src/main.ts",
    "migrate": "tsx src/main.ts --migrate",
    "bench:relay": "pnpm build && tsx bench/relay-load.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@blockyrts/protocol": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15"
  }
}
