27adc55fa","time":1.2,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":-10.0,"y":0.0,"z":0.0}],"uuid":"e45789ad-a4ef-527a-a0c9-b8af31812ac9","time":1.8,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"ecf409d6-4a4d-5e09-b886-ab933eadef0c","time":2.4,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"# cook_hut\n\nCook hut (kitchen tier 2): a mud-and-wattle hut with one chimney, a hanging sign and a cooking bench outside.\n\n- Footprint: 6 x 6 columns (96 x 96 units, 2.70 x 2.70 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -60..36, y 0..106, z -42..43 units.\n- Texture: 256 x 512, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 50, construction_0 26, construction_33 31, construction_66 46, ruined 31 (6 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- 72 x 104 x 64 centred at x 0, z 4\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `cook_hut_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `cook_hut_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_cook_hut` together with the `ruined` set or the finished set.\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `working` | 2.4 | loop | `sign` swings. |\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, -37)\n- `fx_smoke` at (22, 107, 20)\n"}