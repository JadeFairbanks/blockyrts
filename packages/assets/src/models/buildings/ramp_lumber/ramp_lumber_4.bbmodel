b","a000a166-c762-508f-a92f-b0290f308e10","4c1e6ae9-5edc-51b6-af8d-b5f23bb0564c","26886a82-b36f-550d-8af3-f042e0a9dbc0"]},{"name":"ruined","origin":[0.0,0.0,0.0],"color":0,"uuid":"17dbb2bc-760d-56ba-80a8-05a45899c16e","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":false,"autouv":0,"rotation":[0,0,0],"children":["ca742405-2616-5956-81bb-7d5dc41f5f63","bd85d13c-c85a-5926-8f52-473a2c7f5f14","ac7a2763-b7dc-59a0-b257-ba902f7a4f40","6cd6eb19-ccc8-5ec4-b2bb-fe3624ce6b5d","1b5c1a02-65c1-5da4-a7f0-50ae5467e67e","2a3c3035-b20e-58ca-aecd-bb105b722054","a1acc1ca-c19b-54a5-9e75-489cd2d86ddc","4a2cfdcf-a737-528b-863a-d8cb4b3de836","cbc49537-f133-5295-99b4-ba42715ee68a","912d68f5-f8a9-5753-ae2a-16b0feae316f","67657c64-0502-5c58-bd76-fe6b90d06cae","b712c28a-9983-5815-a0a6-6d32caefaf34","4a510a71-122f-5af8-8912-e66eb96e7daa","17efa182-3c29-5116-9100-a2b864a74608","35a794b6-9187-5d26-8dc9-1eab6e5f4cdd","0b8136ae-68f6-5464-8f6c-743eae079893"]}]}],"textures":[{"path":"ramp_lumber_4.png","name":"ramp_lumber_4.png","folder":"","namespace":"","id":"0","width":128,"height":128,"uv_width":128,"uv_height":128,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"2a0f861d-29a4-516f-85fc-519c2eada185","relative_path":"ramp_lumber_4.png","source":"data:image/png;base64,"}],"animations":[],"description":"# ramp_lumber_4\n\nLumber ramp, 4-step: one column wide, 4 columns long (along +Z, climbing toward +Z), rising 16 u (4 terrain steps of 11.25 cm).\n\n- Footprint: 1 x 4 columns (16 x 64 units, 0.45 x 1.80 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -8..8, y -4..16, z -32..33 units.\n- Texture: 128 x 128, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 19, construction_0 11, construction_33 11, construction_66 9, ruined 16 (33 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- ramp wedge: 16 x 16 x 64 (walkable slope 14.0 degrees), centred at the origin\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `ramp_lumber_4_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `ramp_lumber_4_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_ramp_lumber_4` together with the `ruined` set or the finished set.\n"}