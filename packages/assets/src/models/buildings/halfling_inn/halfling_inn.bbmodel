7-0d59-523a-8c0f-acb120a3f619","dccddd9a-18e1-5bf0-a09f-4534c23a11cb","7ad9e8fb-6431-5777-b549-86df486bf60b"]},{"name":"slot_door","origin":[-20.0,0.0,-46.0],"color":0,"uuid":"5cd87878-fd68-5d4f-9774-1b76b0f8067e","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"fx_smoke","origin":[-40.0,189.0,0.0],"color":0,"uuid":"222b3c90-f1a4-5ff8-ae9b-978d3671c424","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"halfling_inn.png","name":"halfling_inn.png","folder":"","namespace":"","id":"0","width":512,"height":512,"uv_width":512,"uv_height":512,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"f7522dbc-ff4d-5850-9569-cf8c0f567e95","relative_path":"halfling_inn.png","source":"data:image/png;base64,"}],"animations":[{"uuid":"06e6069e-fd03-5c4c-a5e2-dafd0522e36e","name":"working","loop":"loop","override":false,"length":2.4,"snapping":24,"selected":false,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"00c0b8fe-7d5e-59a2-bb4e-22b678c7011c":{"name":"sign","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"4a9ef16c-1510-5b73-9c29-8a90259f9588","time":0.0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":10.0,"y":0.0,"z":0.0}],"uuid":"a8c91bec-04a4-5f45-a62f-b8f5dd9bd644","time":0.6,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"3bd5c763-fbe0-53c6-9a4d-84006d7817f8","time":1.2,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":-10.0,"y":0.0,"z":0.0}],"uuid":"80cbe2a5-38df-53c1-b524-b860dff839f9","time":1.8,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"2cb8e37d-a5b2-59ef-b1fd-86c7a5052ded","time":2.4,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"# halfling_inn\n\nHalfling inn: a two-storey timber inn half dug into a grassy hill, mustard-and-green shutters, a round door, a swinging sign and benches outside.\n\n- Footprint: 10 x 9 columns (160 x 144 units, 4.50 x 4.05 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -76..76, y 0..188, z -54..84 units.\n- Texture: 512 x 512, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 162, construction_0 53, construction_33 102, construction_66 122, ruined 170 (6 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- inn: 112 x 180 x 60 centred at x 0, z -6\n- hill behind: 152 x 120 x 60 at z 40\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `halfling_inn_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `halfling_inn_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_halfling_inn` together with the `ruined` set or the finished set.\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `working` | 2.4 | loop | `sign` swings. |\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (-20, 0, -46)\n- `fx_smoke` at (-40, 189, 0)\n"}