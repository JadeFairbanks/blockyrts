7936cd","58dd75bf-a5bc-557f-b4cc-ab787007e787","929013c6-d9f2-582e-97cf-c3dc52aa1884","8ffc24e5-bd79-535b-a2d8-4ad9f5d1a216","2a91f7a4-297b-5aae-95ac-985be62418e2","da786235-ad25-50f8-997b-a534e05b96ce","b453396b-d501-5453-9657-6a89d3bfd1e0","50a5c6c2-d556-5a35-bb60-f67cc8bc575d","26b42468-41ce-5845-bc3f-3609feb9a725","f7f726be-1fe7-5c0a-81d4-2b8fd94af8e6","24da2f6f-a94b-5351-823d-4dde87c8c871","4a29b004-0c6a-52f2-beaf-3d8fd0a7470a","8a6d6a09-e17a-59ba-bffa-8b118d0176b5","719660ce-53be-5f5e-bb3b-6b91d8046c51","6bfd58dd-d9e1-53b6-aad5-a0a7521353b0"]},{"name":"fx_flame","origin":[0.0,24.0,0.0],"color":0,"uuid":"d0a073e2-5f7e-5d7b-ab6f-f009670a11ee","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"fx_smoke","origin":[0.0,40.0,0.0],"color":0,"uuid":"d8a58458-15b7-55de-a807-f1a54a9629db","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"runkin_fire.png","name":"runkin_fire.png","folder":"","namespace":"","id":"0","width":128,"height":128,"uv_width":128,"uv_height":128,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"258ccaf6-d9db-5120-8cb7-7652993c6c4e","relative_path":"runkin_fire.png","source":"data:image/png;base64,"}],"animations":[],"description":"# runkin_fire\n\nRunkin fire: a big communal fire ring of large stones, a tall stacked-log fire and seat logs around it. Neutral.\n\n- Footprint: 6 x 6 columns (96 x 96 units, 2.70 x 2.70 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -49..49, y 0..30, z -49..49 units.\n- Texture: 128 x 128, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 22, construction_0 17, construction_33 17, construction_66 15, ruined 38 (0 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- fire ring: 56 x 30 x 56 centred at the origin (do not walk through the fire)\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `runkin_fire_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `runkin_fire_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_runkin_fire` together with the `ruined` set or the finished set.\n\n## Attachment and effect points (empty groups)\n\n- `fx_flame` at (0, 24, 0)\n- `fx_smoke` at (0, 40, 0)\n"}