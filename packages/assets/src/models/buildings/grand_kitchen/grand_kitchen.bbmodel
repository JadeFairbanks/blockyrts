_height":512,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"cde9a3b7-3ad6-56c0-81db-55f4cee9dd3e","relative_path":"grand_kitchen.png","source":"data:image/png;base64,"}],"animations":[{"uuid":"2483e384-3613-5f04-9c47-d98cc759b8d0","name":"working","loop":"loop","override":false,"length":2.4,"snapping":24,"selected":false,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"fb3e650b-91e7-577f-bbfe-bf050172ff25":{"name":"sign","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"e159f49e-419c-5912-b539-3ffe05c2c3cc","time":0.0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":10.0,"y":0.0,"z":0.0}],"uuid":"bc6573c7-f88d-5251-84d5-32b907c4fdaa","time":0.6,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"ba484078-276c-5c4a-9803-9ab996d2e696","time":1.2,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":-10.0,"y":0.0,"z":0.0}],"uuid":"3cbc845d-aaa5-530c-a0de-f27f2aa2b4cd","time":1.8,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"70e7f094-a6e0-5a86-9d69-3e8e0ba10071","time":2.4,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"# grand_kitchen\n\nGrand kitchen (tier 5): a long stone hall with three chimneys, two brick bread ovens and a row of hanging hams.\n\n- Footprint: 12 x 7 columns (192 x 112 units, 5.40 x 3.15 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -86..103, y 0..152, z -46..46 units.\n- Texture: 512 x 512, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 87, construction_0 29, construction_33 41, construction_66 58, ruined 39 (6 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- 186 x 140 x 76 centred at x 11, z 2\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `grand_kitchen_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `grand_kitchen_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_grand_kitchen` together with the `ruined` set or the finished set.\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `working` | 2.4 | loop | `sign` swings. |\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, -41)\n- `fx_smoke` at (-40, 153, 2)\n- `fx_smoke_2` at (0, 153, 2)\n- `fx_smoke_3` at (40, 153, 2)\n"}