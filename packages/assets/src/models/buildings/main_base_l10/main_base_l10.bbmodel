":0,"rotation":[0,0,0],"children":[]},{"name":"slot_parapet_5","origin":[23.0,253.0,58.0],"color":0,"uuid":"b9950713-7013-5977-863c-e0b57eecb1f2","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_parapet_6","origin":[-23.0,253.0,58.0],"color":0,"uuid":"5b0a2ac3-aeec-5cf6-b129-3ad5f6056107","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_parapet_7","origin":[-46.0,253.0,35.0],"color":0,"uuid":"90e1a849-d0b9-554c-bbae-c1df82128d98","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_parapet_8","origin":[-46.0,253.0,-11.0],"color":0,"uuid":"da22324d-7ef4-5cd1-ac1c-1fd428e9bc93","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"main_base_l10.png","name":"main_base_l10.png","folder":"","namespace":"","id":"0","width":512,"height":1024,"uv_width":512,"uv_height":1024,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"a551c42e-1d59-5cc4-bf9c-10d30efc2362","relative_path":"main_base_l10.png","source":"data:image/png;base64,"}],"animations":[{"uuid":"5e885c14-bc87-5f74-923d-a5f3864ba94e","name":"idle","loop":"loop","override":false,"length":2.0,"snapping":24,"selected":false,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"6d83bd61-3c04-5765-964e-af6e6d8e355a":{"name":"flag_cloth","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"4f4726f4-4d85-548a-b70d-55d5769cc142","time":0.0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":12.0,"z":0.0}],"uuid":"60e32995-1471-5d50-acd7-5cee2584282f","time":0.5,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"21199ca1-d56a-5161-8d15-ea060cc0255d","time":1.0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":-12.0,"z":0.0}],"uuid":"18a35820-9b72-559d-9d47-761c4566e0e6","time":1.5,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"ab8b0cf7-0eeb-567f-9034-a2c2e294404b","time":2.0,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"# main_base_l10\n\nMain base level 10, Citadel: a tall white-and-grey fortress, the grandest building in the game. Projecting grey bastions with gun ports (cannon muzzles showing), musket loops along white curtain walls, a high keep and a flag tower.\n\n- Footprint: 14 x 14 columns (224 x 224 units, 6.30 x 6.30 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -120..120, y 0..462, z -120..120 units.\n- Texture: 512 x 1024, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 430, construction_0 48, construction_33 169, construction_66 323, ruined 285 (2 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- keep: 108 x 422 x 108 centred at x 0, z 12 (or two boxes: 108 x 256 x 108 and 64 x 166 x 64 above it)\n- curtain wall: 224 x 120 x 224 ring\n- bastions: 48 x 143 x 48 at the corners\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `main_base_l10_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `main_base_l10_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_main_base_l10` together with the `ruined` set or the finished set.\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `idle` | 2.0 | loop | team flag on the flag tower flutters. |\n\n## Attachment and effect points (empty groups)\n\n- `slot_tower_1` at (-92, 135, -92)\n- `slot_tower_2` at (92, 135, -92)\n- `slot_tower_3` at (-92, 135, 92)\n- `slot_tower_4` at (92, 135, 92)\n- `slot_gate` at (0, 0, -122)\n- `slot_door` at (0, 0, -49)\n- `slot_parapet_1` at (-23, 253, -34)\n- `slot_parapet_2` at (23, 253, -34)\n- `slot_parapet_3` at (46, 253, -11)\n- `slot_parapet_4` at (46, 253, 35)\n- `slot_parapet_5` at (23, 253, 58)\n- `slot_parapet_6` at (-23, 253, 58)\n- `slot_parapet_7` at (-46, 253, 35)\n- `slot_parapet_8` at (-46, 253, -11)\n\n## Notes\n\n- Gun ports: 16 in the corner bastions (cannon muzzles at y 75, `muzzle*` cubes), musket loops along all four curtain walls at y 62, three gun ports high on the keep.\n"}