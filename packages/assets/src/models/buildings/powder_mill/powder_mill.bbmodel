-ee31-5eaf-ac67-cf2cd2614086","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_work","origin":[-30.0,0.0,-44.0],"color":0,"uuid":"e7be5203-8a58-5e4f-8d92-caa9cb6eee93","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_dropoff","origin":[0.0,0.0,-20.0],"color":0,"uuid":"e515dddd-6d59-5950-81d1-ade62ed0b098","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"powder_mill.png","name":"powder_mill.png","folder":"","namespace":"","id":"0","width":256,"height":512,"uv_width":256,"uv_height":512,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"a8c636c5-b095-5e76-b36d-fea3ad60f7d6","relative_path":"powder_mill.png","source":"data:image/png;base64,"}],"animations":[{"uuid":"ee9ed425-28d8-5603-95a5-526bbf52dbbc","name":"working","loop":"loop","override":false,"length":4.0,"snapping":24,"selected":false,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"5323b07b-8905-544f-af64-8c20417dc966":{"name":"runner","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"8ed9ce97-1b13-5151-a357-e5e7e5b4932e","time":0,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":0.0,"y":90.0,"z":0.0}],"uuid":"6917c9b5-dd05-5c6b-ad28-96e391ee0935","time":1,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":0.0,"y":180.0,"z":0.0}],"uuid":"2416dc57-3c82-5f17-a460-554dd7a561de","time":2,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":0.0,"y":270.0,"z":0.0}],"uuid":"f94f4ff3-5852-5136-b340-46e6212c4bd4","time":3,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":0.0,"y":360.0,"z":0.0}],"uuid":"1c46191b-061a-5a40-9471-1dcadae6c05e","time":4,"color":-1,"interpolation":"linear"}]}}}],"description":"# powder_mill\n\nPowder mill: a small isolated stone building with very thick walls and a light timber roof (so a blast goes upward), a big edge-runner grinding wheel in the yard, and powder barrels marked with a red band.\n\n- Footprint: 8 x 8 columns (128 x 128 units, 3.60 x 3.60 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -52..59, y 0..101, z -64..53 units.\n- Texture: 256 x 512, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 46, construction_0 29, construction_33 34, construction_66 39, ruined 33 (6 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- mill house: 72 x 104 x 64 centred at x 0, z 20\n- grinding bed: 40 x 32 x 40 at z -44\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `powder_mill_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `powder_mill_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_powder_mill` together with the `ruined` set or the finished set.\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `working` | 4.0 | loop | `runner` edge-runner stone rolls round the bed once per 4 s. |\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, -17)\n- `slot_work` at (-30, 0, -44)\n- `slot_dropoff` at (0, 0, -20)\n\n## Notes\n\n- Light roof: thin grey planks on a shallow pitch (22 u rise) over 8 u thick stone walls (inner shell plus outer skin).\n"}