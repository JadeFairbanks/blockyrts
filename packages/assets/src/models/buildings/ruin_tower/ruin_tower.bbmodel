d","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"ruin_tower.png","name":"ruin_tower.png","folder":"","namespace":"","id":"0","width":256,"height":512,"uv_width":256,"uv_height":512,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"baf6594a-9cfb-5756-b229-aa8c8ee05a92","relative_path":"ruin_tower.png","source":"data:image/png;base64,"}],"animations":[],"description":"# ruin_tower\n\nRuin tower: an old round watchtower from before the game's time, half buried, broken off unevenly, with rubble, moss and grass growing over it. Decoration and lair dressing; already ruined (no states).\n\n- Footprint: 6 x 6 columns (96 x 96 units, 2.70 x 2.70 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -50..56, y 0..139, z -50..50 units.\n- Texture: 256 x 512, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 23, construction_0 0, construction_33 0, construction_66 0, ruined 0 (0 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- tower stump: 70 x 140 x 70 centred at the origin\n\n## Attachment and effect points (empty groups)\n\n- `slot_lair` at (0, 0, 0)\n"}