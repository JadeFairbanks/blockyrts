d-9b9f-20babe2fab30","0ebe272e-e93f-5814-9715-2f797c9e2969","59368a22-f682-5606-bdab-df9043a86241","f86317d4-23e9-533b-8f51-542ee91b5333","8a909fad-45a2-59ca-b3e5-e169133e71fe"]},{"name":"ruined","origin":[0.0,0.0,0.0],"color":0,"uuid":"ffb622bd-e236-511a-9772-9c15775dbec0","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":false,"autouv":0,"rotation":[0,0,0],"children":["7f5b3473-0ea5-5cda-8554-179a9442faf5","29339497-579d-5880-b98c-185f1d2bb068","e967d895-d398-5fb8-a4b1-5fb3cc3adaad","d8c05573-1e1f-527d-9f4a-2bd01a595bf6","54787641-e323-5bf7-9cbe-f4ca75572906","e85172c2-db68-5419-86d0-cc5935434acb","5d607fef-3db9-57e4-88f0-552ed6dddba4","620e6c69-677b-5623-a8cb-7260d8c798cf","d77ac91a-b7c8-5eaa-a970-a7c8fe7e0b56","8185dc47-a569-5320-974f-2739baf4b76d","9649cf33-f45b-5a61-a67c-536282f0dbd6"]}]}],"textures":[{"path":"runkin_wolf_den.png","name":"runkin_wolf_den.png","folder":"","namespace":"","id":"0","width":128,"height":256,"uv_width":128,"uv_height":256,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"c786ac6a-db69-535e-8d5f-cec7b6654dcd","relative_path":"runkin_wolf_den.png","source":"data:image/png;base64,"}],"animations":[],"description":"# runkin_wolf_den\n\nRunkin wolf den: a curved windbreak of hides on poles round a bedding hollow, scattered bones and a scratched marking post. Neutral.\n\n- Footprint: 6 x 6 columns (96 x 96 units, 2.70 x 2.70 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -39..42, y 0..50, z -40..36 units.\n- Texture: 128 x 256, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 23, construction_0 16, construction_33 23, construction_66 21, ruined 11 (13 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- windbreak: 80 x 50 x 50 arc centred at x 0, z 20\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `runkin_wolf_den_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `runkin_wolf_den_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_runkin_wolf_den` together with the `ruined` set or the finished set.\n"}