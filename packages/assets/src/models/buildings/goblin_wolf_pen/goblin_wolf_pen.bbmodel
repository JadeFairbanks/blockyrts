d":"c1c607db-1a91-5a1f-8ca7-7ec9861456af","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"goblin_wolf_pen.png","name":"goblin_wolf_pen.png","folder":"","namespace":"","id":"0","width":256,"height":256,"uv_width":256,"uv_height":256,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"6fb704a6-ee73-5997-babd-19d4799cf7e3","relative_path":"goblin_wolf_pen.png","source":"data:image/png;base64,"}],"animations":[],"description":"# goblin_wolf_pen\n\nGoblin wolf pen: a ring of lashed, leaning stakes with a crude stick gate, gnawed bones and a water trough of a split log.\n\n- Footprint: 8 x 8 columns (128 x 128 units, 3.60 x 3.60 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -66..67, y -0..55, z -65..65 units.\n- Texture: 256 x 256, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 168, construction_0 114, construction_33 114, construction_66 112, ruined 118 (601 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- stake ring: 120 x 50 x 120, 3 u thick, gate 24 u wide in the north side\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `goblin_wolf_pen_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `goblin_wolf_pen_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_goblin_wolf_pen` together with the `ruined` set or the finished set.\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, -70)\n- `slot_pen` at (0, 0, 0)\n"}