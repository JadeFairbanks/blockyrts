":["5c41fabf-052d-50b5-ad82-6ea2a6ed821e","4339f798-e73b-583e-a9f9-4af1aec80ee2","27834259-33a2-58af-8da7-b5b083b5c704"]},{"name":"construction_33","origin":[0.0,0.0,0.0],"color":0,"uuid":"59bf9cdf-9664-5e22-b0b4-808f0a537fee","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":false,"autouv":0,"rotation":[0,0,0],"children":["5d99a888-173d-5e45-a0c4-d63bcb72b3e7","7720fff0-8a00-5b0c-9557-0f571cfb79bf","59263543-bd69-575d-8802-c52e6e4bcf29","95baebc2-3249-5c88-8b69-c87b78a89e84"]},{"name":"construction_66","origin":[0.0,0.0,0.0],"color":0,"uuid":"e11034e2-40ce-5581-88e5-ed9dbbc8d9d4","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":false,"autouv":0,"rotation":[0,0,0],"children":["67ef2eda-5a9d-59bd-b330-a1f2582d8f5f","1362f07e-943a-52ed-8c7e-c0a56bce47a7","765297ca-d60b-5a0f-8706-0a54c131c3b4"]},{"name":"ruined","origin":[0.0,0.0,0.0],"color":0,"uuid":"1b2affa4-f79e-5e8a-9df6-939555120f48","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":false,"autouv":0,"rotation":[0,0,0],"children":["1c12c47d-a165-52cc-b1ac-d72cbfb093f6","371037a4-6d8b-503c-b5bb-dc58d99ed604","63617264-4411-5a16-89cf-d9e8db78b762","fc3242de-1cf0-5a61-9a8d-5e51fbf08e79","95b76734-65ee-5de3-a3de-af5fe755a571","4c3a8939-8b71-5b0d-8239-a05b167334a1"]}]}],"textures":[{"path":"goblin_totem.png","name":"goblin_totem.png","folder":"","namespace":"","id":"0","width":64,"height":128,"uv_width":64,"uv_height":128,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"c52d3420-d5f2-5898-882c-906973353f75","relative_path":"goblin_totem.png","source":"data:image/png;base64,"}],"animations":[],"description":"# goblin_totem\n\nGoblin totem: a crooked pole hung with green-glowing hexstones on cords and skulls, a hide banner and crude paint.\n\n- Footprint: 2 x 2 columns (32 x 32 units, 0.90 x 0.90 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -18..18, y 0..116, z -10..10 units.\n- Texture: 64 x 128, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 18, construction_0 3, construction_33 4, construction_66 3, ruined 6 (10 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- 8 x 116 x 8 centred at the origin\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `goblin_totem_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `goblin_totem_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_goblin_totem` together with the `ruined` set or the finished set.\n"}