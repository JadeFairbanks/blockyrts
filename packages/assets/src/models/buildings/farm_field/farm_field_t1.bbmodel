0,3.0,-48.0],"color":0,"uuid":"543f286d-6550-5223-8ef9-03760454be1a","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_row_2","origin":[0.0,3.0,-32.0],"color":0,"uuid":"e664584b-07a8-563d-b129-be520f248f2d","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_row_3","origin":[0.0,3.0,-16.0],"color":0,"uuid":"0a1288b6-4443-55b0-a04f-1052157ed59e","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_row_4","origin":[0.0,3.0,0.0],"color":0,"uuid":"e7a09372-1e63-5244-9158-83d070253806","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_row_5","origin":[0.0,3.0,16.0],"color":0,"uuid":"a4b43719-9f64-5a58-8c45-40350236a403","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_row_6","origin":[0.0,3.0,32.0],"color":0,"uuid":"7b7ca8c1-e2bf-51f9-b259-36b9e9e5b3af","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_row_7","origin":[0.0,3.0,48.0],"color":0,"uuid":"7dcb9c0f-f122-5d07-b74e-5ef4d5322546","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"farm_field_t1.png","name":"farm_field_t1.png","folder":"","namespace":"","id":"0","width":128,"height":256,"uv_width":128,"uv_height":256,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"10076567-4370-5227-8a1c-eef276334fc7","relative_path":"farm_field_t1.png","source":"data:image/png;base64,"}],"animations":[],"description":"# farm_field_t1\n\nFarm field tier 1: a stick fence round dug rows. Crops are separate props (G4) placed on the rows (each row 1 column = 16 u wide).\n\n- Footprint: 8 x 8 columns (128 x 128 units, 3.60 x 3.60 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -63..63, y -0..44, z -63..63 units.\n- Texture: 128 x 256, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 72, construction_0 17, construction_33 17, construction_66 15, ruined 15 (1 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- 126 x 44 x 126 (w x h x d), centred at x 0, z 0\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `farm_field_t1_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `farm_field_t1_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_farm_field_t1` together with the `ruined` set or the finished set.\n\n## Attachment and effect points (empty groups)\n\n- `slot_dropoff` at (0, 0, -70)\n- `slot_row_1` at (0, 3, -48)\n- `slot_row_2` at (0, 3, -32)\n- `slot_row_3` at (0, 3, -16)\n- `slot_row_4` at (0, 3, 0)\n- `slot_row_5` at (0, 3, 16)\n- `slot_row_6` at (0, 3, 32)\n- `slot_row_7` at (0, 3, 48)\n\n## Notes\n\n- Rows run along X, 7 rows of 16 u on 8 x 8 columns; `slot_row_N` marks the centre line of each row (crop props sit there).\n"}