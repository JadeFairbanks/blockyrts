3-6b36db8a1885","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_door","origin":[0.0,0.0,-44.0],"color":0,"uuid":"86ef798e-e2d3-5a1e-9c73-7fd39acea465","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_work","origin":[0.0,0.0,-64.0],"color":0,"uuid":"035c150b-fb9a-50d6-925c-0dae1798af49","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"dwarf_forge.png","name":"dwarf_forge.png","folder":"","namespace":"","id":"0","width":256,"height":512,"uv_width":256,"uv_height":512,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"ee0d2b05-3b56-5bbc-b7cd-77ba8a0ed17b","relative_path":"dwarf_forge.png","source":"data:image/png;base64,"}],"animations":[{"uuid":"4947d270-d837-57a8-9b4c-64f56c3d0b27","name":"working","loop":"loop","override":false,"length":1.6,"snapping":24,"selected":false,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"a8a79332-7925-5a65-98ac-d2973ba711dc":{"name":"bellows_top","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"6c003600-4a3d-5074-9747-621f29feac6c","time":0.0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-12.0}],"uuid":"1b852bfa-52f2-5d3c-80c4-f5e686963b48","time":0.72,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"f87b7a3c-0c36-5084-9ab4-081ff652bd7e","time":1.6,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"# dwarf_forge\n\nDwarf forge: a stone forge-house with an iron chimney stack, a glowing hearth seen through a wide arch, an anvil out front and bellows that pump (`working`).\n\n- Footprint: 8 x 7 columns (128 x 112 units, 3.60 x 3.15 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -54..50, y 0..176, z -56..42 units.\n- Texture: 256 x 512, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 23, construction_0 17, construction_33 37, construction_66 40, ruined 17 (2 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- 96 x 176 x 72 centred at x 0, z 4\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `dwarf_forge_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `dwarf_forge_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_dwarf_forge` together with the `ruined` set or the finished set.\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `working` | 1.6 | loop | `bellows` bellows pump. |\n\n## Attachment and effect points (empty groups)\n\n- `fx_flame` at (0, 16, -36)\n- `fx_smoke` at (28, 178, 18)\n- `slot_door` at (0, 0, -44)\n- `slot_work` at (0, 0, -64)\n"}