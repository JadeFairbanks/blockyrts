e":"slot_work","origin":[10.0,0.0,-30.0],"color":0,"uuid":"fe279e41-7344-55ad-a8df-41c6d8002f87","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_dropoff","origin":[-30.0,0.0,-46.0],"color":0,"uuid":"bacc29ec-8325-5c2e-b240-0c47037c6954","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"forge_l2.png","name":"forge_l2.png","folder":"","namespace":"","id":"0","width":256,"height":256,"uv_width":256,"uv_height":256,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"573a8494-8ec3-5918-befe-765f29e51c01","relative_path":"forge_l2.png","source":"data:image/png;base64,"}],"animations":[{"uuid":"f43fbeb0-68e9-5ccc-b238-b3fb8c735c39","name":"working","loop":"loop","override":false,"length":1.6,"snapping":24,"selected":false,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"5002fc64-5d03-5110-b7cd-ff488208d3f4":{"name":"bellows_top","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"72791078-9766-57df-b449-df1d31d0b022","time":0.0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-12.0}],"uuid":"fe27d194-f25e-53eb-9a40-65a23ca416b4","time":0.72,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"03cc4a38-a57c-59a8-9a4e-cdcd17c16a69","time":1.6,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"# forge_l2\n\nBloomery (forge level 2): a squat clay furnace tower with a tapping arch, big leather bellows on a frame, a stone smithy shed with anvil.\n\n- Footprint: 7 x 6 columns (112 x 96 units, 3.15 x 2.70 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -48..48, y 0..76, z -40..42 units.\n- Texture: 256 x 256, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 32, construction_0 28, construction_33 28, construction_66 32, ruined 28 (6 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- furnace: 32 x 68 x 32 at x -14, z 0\n- shed: 88 x 76 x 22 at z 29\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `forge_l2_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `forge_l2_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_forge_l2` together with the `ruined` set or the finished set.\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `working` | 1.6 | loop | `bellows` bellows pump. |\n\n## Attachment and effect points (empty groups)\n\n- `fx_smoke` at (-14, 68, 0)\n- `fx_flame` at (-14, 12, -18)\n- `slot_work` at (10, 0, -30)\n- `slot_dropoff` at (-30, 0, -46)\n"}