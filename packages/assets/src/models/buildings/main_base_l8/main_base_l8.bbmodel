3199dd7-345a-5b0e-a96e-32b97a9a205d","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_tower_1","origin":[-96.0,143.0,-96.0],"color":0,"uuid":"cb77c453-08a1-55b3-9fed-55eecd67ace5","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_tower_2","origin":[96.0,143.0,-96.0],"color":0,"uuid":"7c4c3809-b4c8-566c-bf2e-ca42b5509dbe","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_tower_3","origin":[-96.0,143.0,96.0],"color":0,"uuid":"660fb9d1-7391-55c4-ad36-9052b9731e5a","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_tower_4","origin":[96.0,143.0,96.0],"color":0,"uuid":"c690d383-9526-5564-9a3c-97fb422eb411","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_gate","origin":[0.0,0.0,-122.0],"color":0,"uuid":"04eeb847-faa2-5255-87c9-1e1f06d1496f","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"main_base_l8.png","name":"main_base_l8.png","folder":"","namespace":"","id":"0","width":512,"height":1024,"uv_width":512,"uv_height":1024,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"3677f891-9a7d-520a-a7f8-9ee987e8100f","relative_path":"main_base_l8.png","source":"data:image/png;base64,"}],"animations":[],"description":"# main_base_l8\n\nMain base level 8, Castle: dressed stone, a tall keep, crenellated walls on the footprint edge with corner towers and a twin-towered gatehouse.\n\n- Footprint: 14 x 14 columns (224 x 224 units, 6.30 x 6.30 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -119..119, y 0..348, z -119..119 units.\n- Texture: 512 x 1024, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 348, construction_0 53, construction_33 188, construction_66 238, ruined 258 (10 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- keep: 100 x 350 x 100 centred at x 0, z 8\n- curtain wall: 224 x 108 x 224 ring\n- corner towers: 40 x 172 x 40\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `main_base_l8_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `main_base_l8_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_main_base_l8` together with the `ruined` set or the finished set.\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, -49)\n- `slot_parapet_1` at (-20, 273, -32)\n- `slot_parapet_2` at (20, 273, -32)\n- `slot_parapet_3` at (40, 273, -12)\n- `slot_parapet_4` at (40, 273, 28)\n- `slot_parapet_5` at (20, 273, 48)\n- `slot_parapet_6` at (-20, 273, 48)\n- `slot_parapet_7` at (-40, 273, 28)\n- `slot_parapet_8` at (-40, 273, -12)\n- `slot_tower_1` at (-96, 143, -96)\n- `slot_tower_2` at (96, 143, -96)\n- `slot_tower_3` at (-96, 143, 96)\n- `slot_tower_4` at (96, 143, 96)\n- `slot_gate` at (0, 0, -122)\n"}