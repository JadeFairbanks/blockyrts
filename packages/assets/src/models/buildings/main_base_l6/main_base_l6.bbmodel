in":[36.0,223.0,18.0],"color":0,"uuid":"91c99ba4-a833-5102-861e-20fbf1d3c9fb","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_parapet_5","origin":[18.0,223.0,36.0],"color":0,"uuid":"0125d1e8-ab27-5ebc-9a1b-53b421a4649e","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_parapet_6","origin":[-18.0,223.0,36.0],"color":0,"uuid":"8c0472bd-6f0e-5546-b04e-0ed17991a6d8","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_parapet_7","origin":[-36.0,223.0,18.0],"color":0,"uuid":"4196f0a8-567c-54d1-b7a5-7434cab0d70b","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_parapet_8","origin":[-36.0,223.0,-18.0],"color":0,"uuid":"1e3813f2-13f1-502e-99f3-68f3bbadea50","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"fx_smoke","origin":[-96.0,153.0,6.0],"color":0,"uuid":"463ce68a-5b83-5d5e-acb5-a13f79df85fd","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"fx_smoke_2","origin":[96.0,153.0,6.0],"color":0,"uuid":"0d3812f6-0666-5b8e-b674-0fac0476b797","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_dropoff","origin":[30.0,0.0,-60.0],"color":0,"uuid":"1b33c189-53b3-570c-83e9-1f77c90ed18a","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"main_base_l6.png","name":"main_base_l6.png","folder":"","namespace":"","id":"0","width":512,"height":512,"uv_width":512,"uv_height":512,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"8db4ea9e-c19d-5026-857e-0c7761138e87","relative_path":"main_base_l6.png","source":"data:image/png;base64,"}],"animations":[],"description":"# main_base_l6\n\nMain base level 6, Keep: a square stone tower in the middle with a small mage balcony (mages train from here), hall wings either side.\n\n- Footprint: 14 x 14 columns (224 x 224 units, 6.30 x 6.30 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -112..112, y 0..231, z -112..112 units.\n- Texture: 512 x 512, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 337, construction_0 37, construction_33 131, construction_66 189, ruined 123 (10 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- keep: 88 x 234 x 88 (w x h x d) centred at the origin\n- wings: two 64 x 160 x 96 boxes centred at x -72 / +72, z 6\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `main_base_l6_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `main_base_l6_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_main_base_l6` together with the `ruined` set or the finished set.\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, -51)\n- `slot_balcony` at (0, 153, -50)\n- `slot_parapet_1` at (-18, 223, -36)\n- `slot_parapet_2` at (18, 223, -36)\n- `slot_parapet_3` at (36, 223, -18)\n- `slot_parapet_4` at (36, 223, 18)\n- `slot_parapet_5` at (18, 223, 36)\n- `slot_parapet_6` at (-18, 223, 36)\n- `slot_parapet_7` at (-36, 223, 18)\n- `slot_parapet_8` at (-36, 223, -18)\n- `fx_smoke` at (-96, 153, 6)\n- `fx_smoke_2` at (96, 153, 6)\n- `slot_dropoff` at (30, 0, -60)\n"}