,"855778cf-de7d-5ab9-801a-45eeb1e42c23","7b029f88-e8c0-5125-9996-5159e35725be"]},{"name":"slot_door","origin":[-24.0,0.0,-33.0],"color":0,"uuid":"b178f17d-4bb8-5e4f-ab1a-d46db76f5d68","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"scriptorium.png","name":"scriptorium.png","folder":"","namespace":"","id":"0","width":512,"height":512,"uv_width":512,"uv_height":512,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"5b2d037a-eb8d-577a-bc71-1c376148e602","relative_path":"scriptorium.png","source":"data:image/png;base64,"}],"animations":[],"description":"# scriptorium\n\nScriptorium: a stone building with tall arched windows and a square book tower whose upper room is lined with shelves of coloured books (seen through the windows).\n\n- Footprint: 10 x 8 columns (160 x 128 units, 4.50 x 3.60 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -78..73, y 0..212, z -28..52 units.\n- Texture: 512 x 512, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 69, construction_0 26, construction_33 42, construction_66 55, ruined 40 (6 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- hall: 96 x 140 x 72 centred at x -24, z 12\n- book tower: 48 x 214 x 48 at x 48, z 12\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `scriptorium_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `scriptorium_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_scriptorium` together with the `ruined` set or the finished set.\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (-24, 0, -33)\n"}