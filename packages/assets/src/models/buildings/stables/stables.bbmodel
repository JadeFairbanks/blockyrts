0.0,14.0],"color":0,"uuid":"644b0691-05b8-5513-942c-8ab7ffecdd97","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_rally","origin":[100.0,0.0,-44.0],"color":0,"uuid":"9e52c168-c600-512b-8e94-2f388ded6f8d","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"stables.png","name":"stables.png","folder":"","namespace":"","id":"0","width":512,"height":512,"uv_width":512,"uv_height":512,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"9b164da3-84a0-566b-8e84-8850135ae353","relative_path":"stables.png","source":"data:image/png;base64,"}],"animations":[],"description":"# stables\n\nStables: a long stall building with split half-doors (top halves open), a hay rack along the front, and a fenced riding ring.\n\n- Footprint: 14 x 12 columns (224 x 192 units, 6.30 x 5.40 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -102..102, y 0..127, z -94..92 units.\n- Texture: 512 x 512, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 103, construction_0 28, construction_33 37, construction_66 49, ruined 28 (6 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- stall building: 192 x 128 x 64 centred at x 0, z 56\n- riding ring: fence 192 x 18 x 96 at z -44 (walk-through)\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `stables_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `stables_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_stables` together with the `ruined` set or the finished set.\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, 14)\n- `slot_rally` at (100, 0, -44)\n"}