"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"a28618fd-fa52-5701-b935-7f549f18a6ff","relative_path":"dwarf_city_gate.png","source":"data:image/png;base64,"}],"animations":[{"uuid":"03341622-5e16-5750-a510-4a0cbe9cd15b","name":"open","loop":"once","override":false,"length":4.0,"snapping":24,"selected":false,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"6ca55646-0dd3-5073-99a1-4420e0466dd8":{"name":"door_l","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"09ccd721-9673-5ce6-892c-b6e301cf0091","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":-86.0,"z":0.0}],"uuid":"55166dc9-1527-50b9-b36f-02b4d73885a8","time":3.4,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":-85.0,"z":0.0}],"uuid":"eb7972de-1e77-5a8c-9e90-2fe82fcfd79f","time":4,"color":-1,"interpolation":"catmullrom"}]},"5ee058dc-cc2d-582a-920d-344a55e4f52c":{"name":"door_r","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"4f37ca13-d163-54c4-bb74-3a46224e3f97","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":86.0,"z":0.0}],"uuid":"f8b067ee-7d27-5aae-86c7-4102b6fd19eb","time":3.4,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":85.0,"z":0.0}],"uuid":"d4912635-60c0-52ac-ae2b-14a22da8cab0","time":4,"color":-1,"interpolation":"catmullrom"}]}}},{"uuid":"bf08e011-512b-56c8-a7cd-844b058d5027","name":"close","loop":"once","override":false,"length":4.0,"snapping":24,"selected":false,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"6ca55646-0dd3-5073-99a1-4420e0466dd8":{"name":"door_l","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":-85.0,"z":0.0}],"uuid":"6e7e547e-b4a2-570e-a6e9-591e50312da6","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":1.0,"z":0.0}],"uuid":"885fb3e6-c64d-5e15-9bcc-a5f94ae6e746","time":3.6,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"2be241d1-c41e-5072-95f7-83d3f69668dc","time":4,"color":-1,"interpolation":"catmullrom"}]},"5ee058dc-cc2d-582a-920d-344a55e4f52c":{"name":"door_r","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":85.0,"z":0.0}],"uuid":"0094223e-7113-5a5a-9a5e-6f0643a65bba","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":-1.0,"z":0.0}],"uuid":"816d85d2-9669-57a0-805c-9b7276cef582","time":3.6,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"6d4d4e14-14e1-5c50-82c5-6127f8983de4","time":4,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"# dwarf_city_gate\n\nDwarf city gate: a huge carved stone gate set into a cliff face, iron-bound bronze doors under a stepped lintel with a carved face, and two stone guardian statues with axes. Neutral.\n\n- Footprint: 20 x 8 columns (320 x 128 units, 9.00 x 3.60 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -176..178, y 0..330, z -120..64 units.\n- Texture: 512 x 1024, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 47, construction_0 40, construction_33 78, construction_66 97, ruined 91 (0 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- cliff and gate: 354 x 330 x 70 centred at x 0, z 30 (the 88 x 196 doorway at x 0 is the way in)\n- statues: two 66 x 190 x 66 boxes at x -110 / +110, z -30\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `dwarf_city_gate_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `dwarf_city_gate_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_dwarf_city_gate` together with the `ruined` set or the finished set.\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `open` | 4.0 | once | the great doors swing inward slowly and hold. |\n| `close` | 4.0 | once | the doors swing shut. |\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, -24)\n"}