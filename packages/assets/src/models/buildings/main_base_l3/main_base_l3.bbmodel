503-6820-c14c-129c-6c2183c7f82a","9f46e16d-0bd5-0711-a708-d04112d93022","4cd5b15f-bbca-6a3a-f5ed-7d842e66fd24","1e008cde-7bae-814c-e09f-03a6dce251c2","642ff6b3-dba7-c169-4fbe-74e4ebe5b775","4d6d6476-198b-abea-1ce6-05e1aee955d4","fa5bd684-6d96-3b98-36be-43007cb2a1ad","1b0bb742-9338-c367-a7f2-3c3854178d2b"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"textures":[{"name":"main_base_l3.png","path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":1024,"height":1024,"uv_width":1024,"uv_height":1024,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"086b2ab2-b2be-5d08-a566-7d3bd2e0f2e7","source":"data:image/png;base64,","relative_path":""}],"description":"# main_base_l3\n\nMain base level 3, Hall with parapets: a two-storey timber hall with a walkway around the roof edge behind a waist-high wall, where ranged units stand and fight. A stair hut gives roof access.\n\nRemade in Patch 5 with the same layout and much more detail: honey vertical planks in dark timber framing on a cobble footing, a dentil cornice, twenty lit windows with shutters, an iron-strapped double door with lanterns, a parapet walk with braziers, a bell, a spear rack and stores, a stair hut with a weathervane, a stepped stone chimney, and a busier yard (hay cart, archery target, weapon rack, lamp posts). The spit and roast over the yard campfire are their own bone, `spit_roast` (pivot on the spit rod), so the game can turn it without stopping.\n\nRemade in Patch 5 with the same layout and much more detail: honey vertical planks in dark timber framing on a cobble footing, a dentil cornice, twenty lit windows with shutters, an iron-strapped double door with lanterns, a parapet walk with braziers, a bell, a spear rack and stores, a stair hut with a weathervane, a stepped stone chimney, and a busier yard (hay cart, archery target, weapon rack, lamp posts).\n\n- Footprint: 14 x 14 columns (224 x 224 units, 6.30 x 6.30 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -112..112, y -1..224, z -114..112 units.\n- Texture: 1024 x 1024, 1 px per unit, square pixels, nearest filtering, flat pixel-art tones per material.\n- Cubes: finished 725, construction_0 135, construction_33 404, construction_66 547, ruined 533 (the state sets are cut from the finished cubes and map into the texture regions of the faces they were cut from).\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and footing with materials waiting, then walls rising inside scaffold).\n- `ruined`: broken walls at uneven heights, rubble and fallen beams.\n- `main_base_l3_damaged.png`: damaged texture (cracks, scorch) for the same UVs; works on every group set.\n\n## Hit box\n\n- 223 x 205 x 223 (w x h x d), centred at x 0, z 0\n\n## Notes\n\n- Roof walkway at y 154 (4.4 m) behind a 19 u (53 cm) parapet over a 3 u deck lip: waist height for a 60 u human standing on the deck.\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, -65)\n- `slot_parapet_1` at (-29, 154, -50)\n- `slot_parapet_2` at (29, 154, -50)\n- `slot_parapet_3` at (58, 154, -23)\n- `slot_parapet_4` at (58, 154, 31)\n- `slot_parapet_5` at (29, 154, 58)\n- `slot_parapet_6` at (-29, 154, 58)\n- `slot_parapet_7` at (-58, 154, 31)\n- `slot_parapet_8` at (-58, 154, -23)\n- `fx_smoke` at (-40, 203, 30)\n- `fx_flame` at (84, 12, -84)\n- `slot_dropoff` at (30, 0, -70)\n- `fx_window_1` at (-32, 46.8, -59.5)\n- `fx_window_2` at (32, 46.8, -59.5)\n- `fx_window_3` at (-32, 46.8, 67.5)\n- `fx_window_4` at (0, 46.8, 67.5)\n- `fx_window_5` at (32, 46.8, 67.5)\n- `fx_window_6` at (-67.5, 46.8, -26)\n- `fx_window_7` at (67.5, 46.8, -26)\n- `fx_window_8` at (-67.5, 46.8, 4)\n- `fx_window_9` at (67.5, 46.8, 4)\n- `fx_window_10` at (-67.5, 46.8, 34)\n- `fx_window_11` at (67.5, 46.8, 34)\n- `fx_window_13` at (-32, 121.8, 67.5)\n- `fx_window_14` at (0, 121.8, -59.5)\n- `fx_window_15` at (0, 121.8, 67.5)\n- `fx_window_17` at (32, 121.8, 67.5)\n- `fx_window_18` at (-67.5, 121.8, -26)\n- `fx_window_19` at (67.5, 121.8, -26)\n- `fx_window_20` at (-67.5, 121.8, 4)\n- `fx_window_21` at (67.5, 121.8, 4)\n- `fx_window_22` at (-67.5, 121.8, 34)\n- `fx_window_23` at (67.5, 121.8, 34)\n- `fx_window_hut1` at (22.5, 172, 40)\n- `fx_window_hut2` at (57.5, 172, 40)\n- `fx_window_hut3` at (40, 172, 57.5)\n- `fx_fire` at (84, 12, -84)"}