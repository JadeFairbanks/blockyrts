ected":false,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"5c18bc0e-262b-5e3d-8e97-29e9fdffb581":{"name":"sheave","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"674cbcfb-55de-52f1-aba4-f6a1ebeecdd3","time":0,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":90.0,"y":0.0,"z":0.0}],"uuid":"4b51b192-3fc2-539f-a43b-537886d5be81","time":0.75,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":180.0,"y":0.0,"z":0.0}],"uuid":"f1d5ff45-e904-528b-96d1-cacd055bcb41","time":1.5,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":270.0,"y":0.0,"z":0.0}],"uuid":"3f8eee3e-e945-5edf-869d-047d285aa252","time":2.25,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":360.0,"y":0.0,"z":0.0}],"uuid":"a2fb42f3-ddf2-5196-a834-def60be2b26f","time":3.0,"color":-1,"interpolation":"linear"}]},"e712e2e2-7541-547f-8d72-f99e30b0362d":{"name":"drum","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"c2f36c3d-85d2-518a-b94e-2070babdb94c","time":0,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":90.0,"y":0.0,"z":0.0}],"uuid":"c01ed531-71bb-549a-a5dd-26835debd71c","time":0.75,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":180.0,"y":0.0,"z":0.0}],"uuid":"6b02786c-abce-5919-bc36-07f767440df2","time":1.5,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":270.0,"y":0.0,"z":0.0}],"uuid":"b3dbc912-4922-59a2-aa78-c050e497d301","time":2.25,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":360.0,"y":0.0,"z":0.0}],"uuid":"0c42aedc-27b0-5e69-87b3-5af281152feb","time":3,"color":-1,"interpolation":"linear"}]}}}],"description":"# mineshaft_t2\n\nMineshaft tier 2: a taller squared-timber head-frame with a sheave wheel, a horse-gin style winding drum in a shed, and an ore bin.\n\n- Footprint: 8 x 7 columns (128 x 112 units, 3.60 x 3.15 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -56..80, y 0..101, z -24..50 units.\n- Texture: 256 x 256, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 36, construction_0 22, construction_33 33, construction_66 41, ruined 12 (7 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- head-frame: 32 x 100 x 32 centred at the origin\n- winder shed: 52 x 62 x 52 at x 52, z 4\n- ore bin: 32 x 25 x 32 at x -40, z -8\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `mineshaft_t2_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `mineshaft_t2_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_mineshaft_t2` together with the `ruined` set or the finished set.\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `working` | 3.0 | loop | `sheave` turns once per 3 s. Winding `drum` turns with it. |\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, -24)\n- `slot_dropoff` at (-40, 0, -32)\n"}