:true,"uuid":"4b8b076a-42b0-59b7-8c0d-bef024be01be","relative_path":"mineshaft_t3.png","source":"data:image/png;base64,"}],"animations":[{"uuid":"bbd0ca7e-ef62-5876-a60d-803da6ed0b5a","name":"working","loop":"loop","override":false,"length":3.0,"snapping":24,"selected":false,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"d31bf1ca-8f37-5428-8fe1-516447570c98":{"name":"winding_wheel","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"f4795c24-0940-545c-83c9-0327a8f6f44b","time":0,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":90.0,"y":0.0,"z":0.0}],"uuid":"08135dbc-5db4-51c2-9914-1226b718f646","time":0.75,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":180.0,"y":0.0,"z":0.0}],"uuid":"96807bfb-8e27-5855-8016-68c6cd5f4ffb","time":1.5,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":270.0,"y":0.0,"z":0.0}],"uuid":"1e508050-fa7e-5821-b7f9-2fb199ea5293","time":2.25,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":360.0,"y":0.0,"z":0.0}],"uuid":"ddcad8ae-031c-5a98-856e-81f6edf71644","time":3.0,"color":-1,"interpolation":"linear"}]}}}],"description":"# mineshaft_t3\n\nMineshaft tier 3: a stone engine-house with a big winding wheel on a tall head-frame, rails running out of the shaft with an ore cart.\n\n- Footprint: 12 x 10 columns (192 x 160 units, 5.40 x 4.50 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -70..96, y 0..172, z -92..70 units.\n- Texture: 256 x 512, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 79, construction_0 27, construction_33 48, construction_66 71, ruined 24 (7 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- head-frame: 32 x 152 x 32 centred at the origin\n- engine house: 60 x 170 x 76 at x 64, z 4\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `mineshaft_t3_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `mineshaft_t3_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_mineshaft_t3` together with the `ruined` set or the finished set.\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `working` | 3.0 | loop | `winding_wheel` turns once per 3 s. |\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, -24)\n- `fx_smoke` at (80, 173, 30)\n- `slot_dropoff` at (0, 0, -96)\n"}