-9d47-2db611fd806e","f7e1075a-b4e1-585c-a2f7-52e06b831022","847600c9-ed00-5092-9a63-1a8801d907bb","4cd0eae1-6a9b-5e95-b5d5-860284357525","4d749ef4-fe51-53b6-bbcc-35e786232ea9","394d368d-07ac-5782-8a0b-83bde994dd90","caf96c0a-e3fc-5e23-91e9-20278c2a8960"]},{"name":"ruined","origin":[0.0,0.0,0.0],"color":0,"uuid":"306a414b-2ee1-5188-adde-6d0349ac9006","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":false,"autouv":0,"rotation":[0,0,0],"children":["d10d9f8e-0108-5840-92f9-51bba911d41d","b7c235ae-b95b-569b-94ea-ef8f8ef2bcc6","929b9c3e-40d8-5fe6-9737-4189ff992239","e26fde82-29fc-58ce-97dc-5048bce9d7bb","9d202eb8-dcb2-5b73-bfa4-f0c8dcd1487c","1045a35d-d31b-58d8-865b-17a64ad71594","1d88ed18-d714-5f48-99f2-8b60433bf178","025c7a36-7483-51e4-9497-f319e36f7f6b","3c64c51e-3bf8-573a-86ad-0994f854df37","9dc370ee-68ce-58e9-8e13-a0919bb64018"]},{"name":"slot_wall_walk","origin":[0.0,78.0,6.0],"color":0,"uuid":"38b66ae7-af43-504d-9e5c-aba526f37b4d","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"wall_softwood.png","name":"wall_softwood.png","folder":"","namespace":"","id":"0","width":64,"height":256,"uv_width":64,"uv_height":256,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"36a9592d-3e72-5801-b8b4-d8c0695fcf12","relative_path":"wall_softwood.png","source":"data:image/png;base64,"}],"animations":[],"description":"# wall_softwood\n\nSoftwood wall: a straight segment one column (16 u) long along X, outer face toward -Z. End caps at both ends meet the next segment's cap to form a joint post. Timber (pale, rough, rope-lashed softwood logs), 3 m (106 u) with pointed tops and a fighting step behind at 78 u.\n\n- Footprint: 1 x 1 columns (16 x 16 units, 0.45 x 0.45 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -8..8, y 0..109, z -7..8 units.\n- Texture: 64 x 256, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 14, construction_0 18, construction_33 24, construction_66 29, ruined 10 (0 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- 16 x 106 x 16 centred at x 0, z 2\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `wall_softwood_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `wall_softwood_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_wall_softwood` together with the `ruined` set or the finished set.\n\n## Attachment and effect points (empty groups)\n\n- `slot_wall_walk` at (0, 78, 6)\n"}