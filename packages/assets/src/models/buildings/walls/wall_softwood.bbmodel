50-99a1d4281155","85e43cf0-845a-1334-5c7e-9c05751a992b","b026cc90-53e1-38f0-07b3-ea3888098417","3c4cd67b-a5a4-870b-b892-795420ab6782","898886c7-bf58-9e94-44c6-259a5080ecf5","9eb64b39-ed5f-ebdb-9a8c-827949e9e8ad","cfc1385b-10a3-0b57-4511-97d0aa1d1900","63ccc8c8-b8d9-1f1c-fbc6-3c99700c0a0a","5905ca54-b035-ff51-927d-532c739ca7fd","5d052860-4912-5950-1a79-64ac8047421c","b11ffd48-b54e-9ce4-2031-04b80bbad0fc","82f2c921-1362-6736-51d0-4ba878e2eb43","08559770-bcef-1c7e-40b7-6ba171db1999","52d8cf62-51ad-7a94-7efa-7e6a1310b077","9ea68f75-6999-dcae-f806-8647b662ff50","51e11d5d-416c-24bb-901f-3bfbed70d5c7","3ffdcda3-dcbe-528d-dba6-cd449f8c2e40","11976974-966e-09f5-e09a-edef76b033e6","2bf247ef-1db8-eeb8-4adc-cd484117bb19","e65f85be-7d14-8c82-b183-3313d887fc08","1043615b-da13-45f9-0132-22a236af02e4","f9819069-1b48-0774-fb9c-9d172ccd05a6","00923069-1dae-56bd-32a3-a0619b826eef","67437b64-6015-f75c-4e4a-3983ddeb4cb4"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"textures":[{"name":"wall_softwood.png","path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":128,"height":128,"uv_width":128,"uv_height":128,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"36a9592d-3e72-5801-b8b4-d8c0695fcf12","source":"data:image/png;base64,","relative_path":""}],"description":"# wall_softwood\n\nSoftwood wall: a straight segment one column (16 u) long along X, outer face toward -Z. End caps at both ends meet the next segment's cap to form a joint post. Timber (pale, rough, rope-lashed softwood logs), 3 m (106 u) with pointed tops and a fighting step behind at 78 u.\n\n- Footprint: 1 x 1 columns (16 x 16 units, 0.45 x 0.45 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -8..8, y 0..109, z -7..8 units.\n- Texture: 128 x 128, 1 px per unit, square pixels, nearest filtering, flat pixel-art tones per material (repainted in Patch 5 for colour contrast).\n- Cubes: finished 14, construction_0 19, construction_33 23, construction_66 27, ruined 28 (the state sets are cut from the finished cubes and map into the texture regions of the faces they were cut from).\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and footing with materials waiting, then walls rising inside scaffold).\n- `ruined`: broken walls at uneven heights, rubble and fallen beams.\n- `wall_softwood_damaged.png`: damaged texture (cracks, scorch) for the same UVs; works on every group set.\n\n## Hit box\n\n- 16 x 106 x 16 centred at x 0, z 2\n\n## Attachment and effect points (empty groups)\n\n- `slot_wall_walk` at (0, 78, 6)"}