-575e-88ac-94c4b32f709c","name":"open","loop":"once","override":false,"length":1.6,"snapping":24,"selected":false,"group_name":"","scope":0,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"714a47ca-002f-5f2a-8eee-1dc529b266fb":{"name":"leaf_l","type":"bone","rotation_global":false,"quaternion_interpolation":false,"keyframes":[{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"3851b4b4-6561-5c72-9aca-d301030c707f","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"98","z":"0"}],"uuid":"d5d70fcd-e6cd-5f56-96b4-5206cf396a58","time":1.2,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"95","z":"0"}],"uuid":"b60cd1fa-5910-5fa7-85ea-4b1e85b522f9","time":1.6,"color":-1,"interpolation":"catmullrom"}]},"c260a8df-75f9-5300-8910-73bb68e6d491":{"name":"leaf_r","type":"bone","rotation_global":false,"quaternion_interpolation":false,"keyframes":[{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"14162b51-ccbb-5f3f-bdb4-af278fd5e4d9","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"-98","z":"0"}],"uuid":"fbbab43f-c95e-53d5-89db-c8d3e9e15415","time":1.2,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"-95","z":"0"}],"uuid":"6faa0e47-802c-5b15-9996-666bc643c7fc","time":1.6,"color":-1,"interpolation":"catmullrom"}]}}},{"uuid":"e20c6fed-5bf6-58ed-852a-7af5420c039a","name":"close","loop":"once","override":false,"length":1.6,"snapping":24,"selected":false,"group_name":"","scope":0,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"714a47ca-002f-5f2a-8eee-1dc529b266fb":{"name":"leaf_l","type":"bone","rotation_global":false,"quaternion_interpolation":false,"keyframes":[{"channel":"rotation","data_points":[{"x":"0","y":"95","z":"0"}],"uuid":"2ad76003-0f3d-505d-be72-d76b6f493c2c","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"-2","z":"0"}],"uuid":"7ebbf6a1-3f02-533a-a92b-03125f2f45a2","time":1.3,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"bdf1fe50-2c04-53ff-9842-72ba1e35a68d","time":1.6,"color":-1,"interpolation":"catmullrom"}]},"c260a8df-75f9-5300-8910-73bb68e6d491":{"name":"leaf_r","type":"bone","rotation_global":false,"quaternion_interpolation":false,"keyframes":[{"channel":"rotation","data_points":[{"x":"0","y":"-95","z":"0"}],"uuid":"f6f7010c-e424-5934-bca4-1608cfe1e048","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"2","z":"0"}],"uuid":"9acf6392-f125-502b-944f-93e6b90a8832","time":1.3,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"629c321d-00a0-5602-9ba3-2e728b790c3e","time":1.6,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"# gate_hardwood\n\nHardwood gate, twice as wide in Patch 5: six columns (96 u) along X. Dark log posts with iron bands, caps and spikes, a heavy two-log lintel with iron straps and a crenellated top, and two plank leaves with iron bands, studs, ring handles, hinge straps and a drop-bar bracket. Opening 72 u wide x 90 u tall. Leaves hinged at the jambs (`leaf_l` at x -37, `leaf_r` at x +37) open inward (+Z). Clips `open` and `close`.\n\n- Footprint: 6 x 1 columns (96 x 16 units, 2.70 x 0.45 m), centred on the origin, front faces -Z.\n- Finished bounds: x -48..49, y -3..131, z -8..6 units.\n- Texture: 512 x 256, 1 px per unit, square pixels, nearest filtering, flat pixel-art tones per material.\n- Cubes: finished 129, construction_0 28, construction_33 64, construction_66 105, ruined 55 (the state sets are cut from the finished cubes and map into the texture regions of the faces they were cut from).\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and footing with materials waiting, then walls rising inside scaffold).\n- `ruined`: broken walls at uneven heights, rubble and fallen beams.\n- `gate_hardwood_damaged.png`: damaged texture (cracks, scorch) for the same UVs; works on every group set.\n\n## Hit box\n\n- jambs: two 12 x 131 x 16 boxes at x -42 / +42\n- leaves (when closed): 72 x 92 x 4 at the origin; open leaves do not block\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `open` | 1.6 | once | leaves swing about 95 degrees inward (+Z) and hold open. |\n| `close` | 1.6 | once | leaves swing shut and hold. |\n\n## Attachment points (empty groups)\n\n- `slot_door` at (0, 0, -16)"}