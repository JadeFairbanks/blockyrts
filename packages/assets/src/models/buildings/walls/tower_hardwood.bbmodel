5d1-dabd-9da67413ff95","5b86c205-5890-15fe-2bd6-210df7b018ad","d44346ee-13b1-3969-864b-02631befec99","af4b0737-0c60-9f87-ab4f-e7d13389789d","9b443fa9-7ff4-6528-eaaa-7f559a3b4914","c5a3d272-3840-0dbe-d5c4-41f20d735421","5de28e8b-3d00-6c65-dd88-d8534d282d53","f0771cef-0362-f3ca-0ecd-b8e212474bee","eafa3936-297d-3a28-5832-18646ec3a1e0","7078fdef-2115-fd36-421e-ce7bb7c31349","6beea417-1a49-2d33-63c7-3279484d5ba2","c459f0e8-8ea4-48cd-4def-8d83ff3ad184","9e380653-8f8c-7737-7cfd-ded7d5dee61c","6a34c167-aafe-2174-1040-52b58514ca26","7fd41806-b7de-4206-f8f5-76aa04ba0fa4","470f0150-c193-e7f2-6b70-acf2a6de3f83","0d64cc63-abaf-efcb-ff56-65669076933a","526a3a15-adbc-1fa6-c652-840d07b8b3e7","19ea6307-12a0-182c-1e07-fa2f235edcf0","51247a6c-7a23-2845-7649-1c3d28a2f261","1ea89628-3e2d-73c3-0192-868196dba40f","c500aae0-71f1-b883-bdf0-845fd4ddbc05","d98a9d05-ce65-dd4a-0d9f-37f532c5631c"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"textures":[{"name":"tower_hardwood.png","path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":512,"height":256,"uv_width":512,"uv_height":256,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"06665031-6e84-59da-aab1-b55c868b40a7","source":"data:image/png;base64,","relative_path":""}],"description":"# tower_hardwood\n\nHardwood tower: a 3 x 3 column platform for ranged units, with a parapet and four standing points (`slot_tower_1..4`), a ladder or stair door at the back.\n\nPatch 5: the roof and its posts were raised 12 u (roof underside at y 188) so the four men standing on the deck at y 124 have headroom.\n\n- Footprint: 3 x 3 columns (48 x 48 units, 1.35 x 1.35 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -32..32, y 0..212, z -32..32 units.\n- Texture: 512 x 256, 1 px per unit, square pixels, nearest filtering, flat pixel-art tones per material.\n- Cubes: finished 42, construction_0 28, construction_33 40, construction_66 54, ruined 29 (the state sets are cut from the finished cubes and map into the texture regions of the faces they were cut from).\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and footing with materials waiting, then walls rising inside scaffold).\n- `ruined`: broken walls at uneven heights, rubble and fallen beams.\n- `tower_hardwood_damaged.png`: damaged texture (cracks, scorch) for the same UVs; works on every group set.\n\n## Hit box\n\n- 48 x 200 x 48 centred at the origin\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, 36)\n- `slot_tower_1` at (-12, 124, -12)\n- `slot_tower_2` at (12, 124, -12)\n- `slot_tower_3` at (-12, 124, 12)\n- `slot_tower_4` at (12, 124, 12)"}