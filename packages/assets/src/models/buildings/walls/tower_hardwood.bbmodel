28fc","891dca2b-12df-5d31-9d34-cecffe5dff02","a7e9a0d1-cbd9-50d4-91e7-8ca8d6eeeffc","71801473-53b5-515b-8344-552230bb2a5e","5333c149-ac17-542b-8620-98a568e9df61","c89ae349-c548-50a3-889d-bb995e81820b","a6e2af8a-a98f-5967-861b-b6ac41433cf5","daeafd7b-f0f2-5f39-bc37-c263920973e2","d955003f-b716-56f9-9f13-69b9084e4626","ec09399e-0406-5a98-bb00-d0f604eeb192","dafbfba5-7e6a-5479-b2c6-7b5402643a40","e94da112-a492-50cf-8f68-571f6e143d50","c1614614-7484-52c4-be24-144bbf96faa6"]},{"uuid":"42b283f2-b153-5dfe-afca-ea0fef9be73e","isOpen":false,"children":[]},{"uuid":"ff388baa-5ee8-5fe3-b2a5-869442901f04","isOpen":false,"children":[]},{"uuid":"35593132-d5a9-5639-bbe2-42099be3a7c0","isOpen":false,"children":[]},{"uuid":"5fca5980-4a49-59ee-a80e-7887069a0f5b","isOpen":false,"children":[]},{"uuid":"249abac3-4cb9-5a3f-bd75-88c1477896bd","isOpen":false,"children":[]}]}],"textures":[{"name":"tower_hardwood.png","path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":512,"height":256,"uv_width":512,"uv_height":256,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"06665031-6e84-59da-aab1-b55c868b40a7","source":"data:image/png;base64,","relative_path":""}],"description":"# tower_hardwood\n\nHardwood tower: a 3 x 3 column platform for ranged units, with a parapet and four standing points (`slot_tower_1..4`), a ladder or stair door at the back.\n\n- Footprint: 3 x 3 columns (48 x 48 units, 1.35 x 1.35 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -32..32, y 0..200, z -32..32 units.\n- Texture: 512 x 256, 1 px per unit, square pixels, nearest filtering, flat pixel-art tones per material (repainted in Patch 5 for colour contrast).\n- Cubes: 42, all in `finished`; the construction and ruined state sets and the damaged/abandoned texture variants were removed in Patch 5 (the game draws none of them for buildings).\n\n## Hit box\n\n- 48 x 200 x 48 centred at the origin\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, 36)\n- `slot_tower_1` at (-12, 124, -12)\n- `slot_tower_2` at (12, 124, -12)\n- `slot_tower_3` at (-12, 124, 12)\n- `slot_tower_4` at (12, 124, 12)"}