d","origin":[0.0,0.0,0.0],"color":0,"uuid":"02551f88-1198-5bf6-89f3-4a1f60bd1434","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":false,"autouv":0,"rotation":[0,0,0],"children":["652be4e7-d754-54e4-9566-071f58f6cb23","b53cd9be-23aa-553c-9607-4aaedbc2bc0c","4b699f5f-1256-5a7f-a63b-51547d3d6940","77863d10-a1b0-5a25-9e71-dee053d9d4cc","480c24bc-942d-59d0-996b-0bbb6a19ba17","a04a392c-e5c0-520b-85f9-95ba84f42d6d","ab2d526d-a028-5343-8bd1-be97d5fca580","0cdd3c13-7091-5b06-a7d0-00ce1325862e","7ad6676f-df17-50d1-beac-62d5da1261d8","1f2abf70-fef6-5313-9907-d7173d3f60ac","2f63b330-9a2f-5035-b576-b94db7e47a78","b1cad72d-c9dd-505f-b2c8-45fd8cfaf610","55a47877-2c63-5f1b-b98c-aaaff5f0a8fe","e479c6f9-942a-55cb-a274-12dfe7f62b5a","53288ead-e662-50ea-be62-63a9252d2ae1","895eab79-c747-5038-b2d3-1cf50e52bd2f","306291bd-bcef-5d7c-a615-c1a469f89f2c","d6432ad4-0541-5aca-8a3c-35ff610348c0","9747a65c-e934-587f-b8a4-1d3c38a0c1bd","87519bb9-c6a4-538a-bb90-97ca9c5c414e","9bb70d75-57c2-5d83-b65e-f89e87e32d0a","7d84253b-5188-5a3b-a288-9410e497cb1a","200480b8-e298-53de-90aa-10da66900f48"]},{"name":"slot_door","origin":[0.0,0.0,36.0],"color":0,"uuid":"42b283f2-b153-5dfe-afca-ea0fef9be73e","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_tower_1","origin":[-12.0,124.0,-12.0],"color":0,"uuid":"ff388baa-5ee8-5fe3-b2a5-869442901f04","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_tower_2","origin":[12.0,124.0,-12.0],"color":0,"uuid":"35593132-d5a9-5639-bbe2-42099be3a7c0","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_tower_3","origin":[-12.0,124.0,12.0],"color":0,"uuid":"5fca5980-4a49-59ee-a80e-7887069a0f5b","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_tower_4","origin":[12.0,124.0,12.0],"color":0,"uuid":"249abac3-4cb9-5a3f-bd75-88c1477896bd","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"tower_hardwood.png","name":"tower_hardwood.png","folder":"","namespace":"","id":"0","width":256,"height":256,"uv_width":256,"uv_height":256,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"06665031-6e84-59da-aab1-b55c868b40a7","relative_path":"tower_hardwood.png","source":"data:image/png;base64,"}],"animations":[],"description":"# tower_hardwood\n\nHardwood tower: a 3 x 3 column platform for ranged units, with a parapet and four standing points (`slot_tower_1..4`), a ladder or stair door at the back.\n\n- Footprint: 3 x 3 columns (48 x 48 units, 1.35 x 1.35 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -32..32, y 0..200, z -32..32 units.\n- Texture: 256 x 256, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 42, construction_0 15, construction_33 34, construction_66 46, ruined 23 (2 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- 48 x 200 x 48 centred at the origin\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `tower_hardwood_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `tower_hardwood_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_tower_hardwood` together with the `ruined` set or the finished set.\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, 36)\n- `slot_tower_1` at (-12, 124, -12)\n- `slot_tower_2` at (12, 124, -12)\n- `slot_tower_3` at (-12, 124, 12)\n- `slot_tower_4` at (12, 124, 12)\n"}