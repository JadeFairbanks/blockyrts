-8d17-1f1a85dbda61","time":1.6,"color":-1,"interpolation":"catmullrom"}]},"b08e68d5-0db8-5d60-8142-90a919d77395":{"name":"leaf_r","type":"bone","rotation_global":false,"quaternion_interpolation":false,"keyframes":[{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"9780b4ec-9836-53c8-b164-3aa403f1526f","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"-98","z":"0"}],"uuid":"6fa07653-ba3a-5c85-bf9f-15a15ff6bc16","time":1.2,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"-95","z":"0"}],"uuid":"c6abbec6-515a-5c7a-9837-fad4c01e5cbb","time":1.6,"color":-1,"interpolation":"catmullrom"}]}}},{"uuid":"5dcf31e5-bf4f-5adb-8265-732f56ec77fa","name":"close","loop":"once","override":false,"length":1.6,"snapping":24,"selected":false,"group_name":"","scope":0,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"0b665880-7419-5fe1-934b-9486038b45ad":{"name":"leaf_l","type":"bone","rotation_global":false,"quaternion_interpolation":false,"keyframes":[{"channel":"rotation","data_points":[{"x":"0","y":"95","z":"0"}],"uuid":"ade9038c-4021-5a49-95f8-68fc2eb7adf8","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"-2","z":"0"}],"uuid":"50e8331f-ec5c-57e6-ba0e-e02f4008c2b8","time":1.3,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"f0e0dc97-3353-5e0a-b611-71be8fd24bdb","time":1.6,"color":-1,"interpolation":"catmullrom"}]},"b08e68d5-0db8-5d60-8142-90a919d77395":{"name":"leaf_r","type":"bone","rotation_global":false,"quaternion_interpolation":false,"keyframes":[{"channel":"rotation","data_points":[{"x":"0","y":"-95","z":"0"}],"uuid":"5cc4e92d-36a1-5802-a3d4-15ddc04d90c0","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"2","z":"0"}],"uuid":"7d33397c-4460-50b7-bfcd-670082df6b56","time":1.3,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"8cbebec5-919e-5037-8295-baf9236e3fd0","time":1.6,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"# gate_stone\n\nStone gate, twice as wide in Patch 5: six columns (96 u) along X. Two stone piers with plinths, quoins and arrow slits, a flat arch with voussoirs and a keystone under a battlemented upper wall, and two dark plank doors with iron bands, ring handles and hinge straps. Opening 72 u wide x 90 u tall. Leaves hinged at the jambs (`leaf_l` at x -37, `leaf_r` at x +37) open inward (+Z). Clips `open` and `close`.\n\n- Footprint: 6 x 1 columns (96 x 16 units, 2.70 x 0.45 m), centred on the origin, front faces -Z.\n- Finished bounds: x -48..48, y -1..145, z -10..9 units.\n- Texture: 512 x 256, 1 px per unit, square pixels, nearest filtering, flat pixel-art tones per material.\n- Cubes: finished 125, construction_0 25, construction_33 71, construction_66 123, ruined 56 (the state sets are cut from the finished cubes and map into the texture regions of the faces they were cut from).\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and footing with materials waiting, then walls rising inside scaffold).\n- `ruined`: broken walls at uneven heights, rubble and fallen beams.\n- `gate_stone_damaged.png`: damaged texture (cracks, scorch) for the same UVs; works on every group set.\n\n## Hit box\n\n- jambs: two 12 x 145 x 16 boxes at x -42 / +42\n- leaves (when closed): 72 x 92 x 4 at the origin; open leaves do not block\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `open` | 1.6 | once | leaves swing about 95 degrees inward (+Z) and hold open. |\n| `close` | 1.6 | once | leaves swing shut and hold. |\n\n## Attachment points (empty groups)\n\n- `slot_door` at (0, 0, -16)"}