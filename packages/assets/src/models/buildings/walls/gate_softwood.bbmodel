.6,"color":-1,"interpolation":"catmullrom"}]},"6c2915b4-a8fd-5975-b654-be3040f19967":{"name":"leaf_r","type":"bone","rotation_global":false,"quaternion_interpolation":false,"keyframes":[{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"37e411d3-ad9e-5b66-a9c0-524b879958cc","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"-98","z":"0"}],"uuid":"6d15d897-07a7-5759-af90-f322c1698477","time":1.2,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"-95","z":"0"}],"uuid":"193c09b7-c2a9-5c8a-a9a3-7d1bceae0c1f","time":1.6,"color":-1,"interpolation":"catmullrom"}]}}},{"uuid":"e0727a21-e0bb-58f0-9bb0-ca1b12dd0bef","name":"close","loop":"once","override":false,"length":1.6,"snapping":24,"selected":false,"group_name":"","scope":0,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"9da8029b-c392-5f15-acfc-7c56352360a1":{"name":"leaf_l","type":"bone","rotation_global":false,"quaternion_interpolation":false,"keyframes":[{"channel":"rotation","data_points":[{"x":"0","y":"95","z":"0"}],"uuid":"09d3f1b1-668b-5ff8-b42d-bacfb917df35","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"-2","z":"0"}],"uuid":"fff43585-56ad-57a5-a9e8-5b88f61a0b7c","time":1.3,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"e00e4ff7-4ae7-5fc6-95be-41eac04c4220","time":1.6,"color":-1,"interpolation":"catmullrom"}]},"6c2915b4-a8fd-5975-b654-be3040f19967":{"name":"leaf_r","type":"bone","rotation_global":false,"quaternion_interpolation":false,"keyframes":[{"channel":"rotation","data_points":[{"x":"0","y":"-95","z":"0"}],"uuid":"2a094f91-3abf-5dbe-8936-7bc2d5c802d2","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"2","z":"0"}],"uuid":"c8ee1a49-d900-520c-a581-0f601e2c4d3d","time":1.3,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"1e3e048d-8c95-5e34-97a6-f7c492cb681f","time":1.6,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"# gate_softwood\n\nWooden (softwood) gate, twice as wide in Patch 5: six columns (96 u) along X. Pale rope-lashed log posts with pointed tips, a log lintel topped with a row of stakes, and two plank leaves with bars, a diagonal brace, hinge straps and a drop-bar bracket. Opening 72 u wide x 90 u tall. Leaves hinged at the jambs (`leaf_l` at x -37, `leaf_r` at x +37) open inward (+Z). Clips `open` and `close`.\n\n- Footprint: 6 x 1 columns (96 x 16 units, 2.70 x 0.45 m), centred on the origin, front faces -Z.\n- Finished bounds: x -48..49, y -3..129, z -8..6 units.\n- Texture: 512 x 256, 1 px per unit, square pixels, nearest filtering, flat pixel-art tones per material.\n- Cubes: finished 103, construction_0 32, construction_33 60, construction_66 75, ruined 55 (the state sets are cut from the finished cubes and map into the texture regions of the faces they were cut from).\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and footing with materials waiting, then walls rising inside scaffold).\n- `ruined`: broken walls at uneven heights, rubble and fallen beams.\n- `gate_softwood_damaged.png`: damaged texture (cracks, scorch) for the same UVs; works on every group set.\n\n## Hit box\n\n- jambs: two 12 x 129 x 16 boxes at x -42 / +42\n- leaves (when closed): 72 x 92 x 4 at the origin; open leaves do not block\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `open` | 1.6 | once | leaves swing about 95 degrees inward (+Z) and hold open. |\n| `close` | 1.6 | once | leaves swing shut and hold. |\n\n## Attachment points (empty groups)\n\n- `slot_door` at (0, 0, -16)"}