7","aed48bf3-886e-5442-b393-1ae654592eca","ac14c22c-3981-51c6-8387-23777884d31a","4205a295-a845-5ae7-a5ed-2db4599f0b2c","c48bf738-9ed1-582b-ac07-da268506f65c","2d54a61b-39ce-5f03-b8d9-a45d504c50c6","46303ec7-b74d-58e4-a65d-26ce7e19bdd0","490ab94e-8a21-5460-a73e-eae92727aa1c","3cd74591-ca57-5a3c-920d-4285bb1a1608","bf7ee042-d920-55e0-b1e7-712fc333cc3b","2fefb1f0-52ea-5b72-8e81-d24d0d3ee7c9","02bfac65-8ddf-5e21-a15f-1ffad6f6006f"]},{"uuid":"25a0ed53-9128-5818-ab6f-e523a62f4613","isOpen":false,"children":[]},{"uuid":"3fae2c84-a523-5c71-9d90-93386a412938","isOpen":false,"children":[]},{"uuid":"a9e231dd-0428-5839-88c1-5119624b6228","isOpen":false,"children":[]},{"uuid":"4315e353-37f3-56b0-a174-61ff8eff8aac","isOpen":false,"children":[]},{"uuid":"551021b6-63d6-5362-9111-7be95428c454","isOpen":false,"children":[]}]}],"textures":[{"name":"tower_softwood.png","path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":512,"height":256,"uv_width":512,"uv_height":256,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"ad844863-469f-59d2-9fb6-96bdfca3c0a5","source":"data:image/png;base64,","relative_path":""}],"description":"# tower_softwood\n\nSoftwood tower: a 3 x 3 column platform for ranged units, with a parapet and four standing points (`slot_tower_1..4`), a ladder or stair door at the back.\n\n- Footprint: 3 x 3 columns (48 x 48 units, 1.35 x 1.35 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -32..32, y 0..200, z -32..32 units.\n- Texture: 512 x 256, 1 px per unit, square pixels, nearest filtering, flat pixel-art tones per material (repainted in Patch 5 for colour contrast).\n- Cubes: 42, all in `finished`; the construction and ruined state sets and the damaged/abandoned texture variants were removed in Patch 5 (the game draws none of them for buildings).\n\n## Hit box\n\n- 48 x 200 x 48 centred at the origin\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, 36)\n- `slot_tower_1` at (-12, 124, -12)\n- `slot_tower_2` at (12, 124, -12)\n- `slot_tower_3` at (-12, 124, 12)\n- `slot_tower_4` at (12, 124, 12)"}