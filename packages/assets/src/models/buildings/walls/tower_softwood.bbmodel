-cd9a-f69cc2e3a787","b89e773f-d27a-08a2-f43d-4bde346710b1","02d182e6-e1a8-f2f3-b053-6e503060f974","fae1450c-2aea-fd1e-a027-865f7dd9d4e9","b2f25de7-0a0d-2de2-652e-b9c6fbca5d41","daf64aad-59a7-0eac-006e-726e47dbcc68","bf66b53d-0b0d-9d18-8fbe-b40ba30c82be","73ad1f0d-6553-9c7d-12eb-cda32fb7f225","e38760e5-5a5c-0136-131d-97b879e6121e","811c09f8-bc38-05f9-c79f-3438bdf3f958","a56cf1b7-2abb-4a08-29a1-0ec7b224d234","6bcb9d58-ec99-387f-b3bf-fd2d17363273","7aea8d4e-96d2-3ca1-60fe-150616b5d3a3","7bb93aa1-9e59-bce9-d19f-76530a3024b3","1c16c87b-0489-4289-cd9a-8c7d8f61a4df","70870a83-990c-48db-a3f9-ff0856722db2","580ce1cf-ca0a-66cc-4271-f6d8c5cb059d","c3da5d4f-b908-1242-1656-f45291f9deff","44448d6d-0bae-bc27-d699-bae827d41424","8e5c3dc0-8a34-d693-6bae-50234ce706d1","0038c116-c550-e948-c761-af6e9e7ad683","1c9450c1-3cd8-ee28-7ef3-d3d1f4487bc9"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"textures":[{"name":"tower_softwood.png","path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":512,"height":256,"uv_width":512,"uv_height":256,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"ad844863-469f-59d2-9fb6-96bdfca3c0a5","source":"data:image/png;base64,","relative_path":""}],"description":"# tower_softwood\n\nSoftwood tower: a 3 x 3 column platform for ranged units, with a parapet and four standing points (`slot_tower_1..4`), a ladder or stair door at the back.\n\nPatch 5: the roof and its posts were raised 12 u (roof underside at y 188) so the four men standing on the deck at y 124 have headroom.\n\n- Footprint: 3 x 3 columns (48 x 48 units, 1.35 x 1.35 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -32..32, y 0..212, z -32..32 units.\n- Texture: 512 x 256, 1 px per unit, square pixels, nearest filtering, flat pixel-art tones per material.\n- Cubes: finished 42, construction_0 28, construction_33 40, construction_66 54, ruined 29 (the state sets are cut from the finished cubes and map into the texture regions of the faces they were cut from).\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and footing with materials waiting, then walls rising inside scaffold).\n- `ruined`: broken walls at uneven heights, rubble and fallen beams.\n- `tower_softwood_damaged.png`: damaged texture (cracks, scorch) for the same UVs; works on every group set.\n\n## Hit box\n\n- 48 x 200 x 48 centred at the origin\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, 36)\n- `slot_tower_1` at (-12, 124, -12)\n- `slot_tower_2` at (12, 124, -12)\n- `slot_tower_3` at (-12, 124, 12)\n- `slot_tower_4` at (12, 124, 12)"}