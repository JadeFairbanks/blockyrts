-8f5a-5f19-bed4-95ba1f4ad7b3","2797243c-0f75-5472-beb7-08b528224621","ee4777e5-51fe-5a61-b139-1925e750f41f","84ee172f-2ef8-597c-acca-f97cf94069cb","9fad9f94-4241-57e2-9e78-7c5060a32715","3de1236b-a02a-51ae-a93b-0ab1ab2102ab","736b0ffd-226a-5150-ba4b-b02ccd02f0f4","25c5e1ba-00e6-554a-91f6-15a524454baf","870dbcbd-d4bf-5d30-86a4-8254ff409357","8e07512c-65f1-5171-ad2e-757a07690b12","42d24755-9620-5efb-8722-8bfa7791a556","28d71d05-3b97-5cd6-ab18-9fe2a1caae0c"]},{"name":"slot_door","origin":[0.0,0.0,36.0],"color":0,"uuid":"25a0ed53-9128-5818-ab6f-e523a62f4613","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_tower_1","origin":[-12.0,124.0,-12.0],"color":0,"uuid":"3fae2c84-a523-5c71-9d90-93386a412938","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_tower_2","origin":[12.0,124.0,-12.0],"color":0,"uuid":"a9e231dd-0428-5839-88c1-5119624b6228","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_tower_3","origin":[-12.0,124.0,12.0],"color":0,"uuid":"4315e353-37f3-56b0-a174-61ff8eff8aac","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_tower_4","origin":[12.0,124.0,12.0],"color":0,"uuid":"551021b6-63d6-5362-9111-7be95428c454","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"tower_softwood.png","name":"tower_softwood.png","folder":"","namespace":"","id":"0","width":256,"height":256,"uv_width":256,"uv_height":256,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"ad844863-469f-59d2-9fb6-96bdfca3c0a5","relative_path":"tower_softwood.png","source":"data:image/png;base64,"}],"animations":[],"description":"# tower_softwood\n\nSoftwood tower: a 3 x 3 column platform for ranged units, with a parapet and four standing points (`slot_tower_1..4`), a ladder or stair door at the back.\n\n- Footprint: 3 x 3 columns (48 x 48 units, 1.35 x 1.35 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -32..32, y 0..200, z -32..32 units.\n- Texture: 256 x 256, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 42, construction_0 15, construction_33 34, construction_66 46, ruined 13 (2 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- 48 x 200 x 48 centred at the origin\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `tower_softwood_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `tower_softwood_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_tower_softwood` together with the `ruined` set or the finished set.\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, 36)\n- `slot_tower_1` at (-12, 124, -12)\n- `slot_tower_2` at (12, 124, -12)\n- `slot_tower_3` at (-12, 124, 12)\n- `slot_tower_4` at (12, 124, 12)\n"}