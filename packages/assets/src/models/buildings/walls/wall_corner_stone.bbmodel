0-a716-dcfb-0e4d-ceca5573bbb8","05dd9295-f738-be3f-4593-ffc5a3c0b91d","b6140c4a-adf0-6721-6aa7-0d3d407431b8","16eedcb1-39ad-18bd-b9c7-82fe61b370b6","aeade49d-34ad-4ebd-1659-d6c51b98c63d","528c5015-4794-58e7-c143-6227415abef3","aa4205dc-0ec2-3ac8-2359-b9911c2c6e25"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"textures":[{"name":"wall_corner_stone.png","path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":128,"height":256,"uv_width":128,"uv_height":256,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"7cf616bf-4477-5fc8-9e32-9473611af044","source":"data:image/png;base64,","relative_path":""}],"description":"# wall_corner_stone\n\nStone wall corner: an L joint filling one column; walls leave along -X... +X (north face) and along +Z (west face), with a corner post.\n\n- Footprint: 1 x 1 columns (16 x 16 units, 0.45 x 0.45 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -9..8, y 0..128, z -9..8 units.\n- Texture: 128 x 256, 1 px per unit, square pixels, nearest filtering, flat pixel-art tones per material (repainted in Patch 5 for colour contrast).\n- Cubes: finished 5, construction_0 17, construction_33 23, construction_66 22, ruined 24 (the state sets are cut from the finished cubes and map into the texture regions of the faces they were cut from).\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and footing with materials waiting, then walls rising inside scaffold).\n- `ruined`: broken walls at uneven heights, rubble and fallen beams.\n- `wall_corner_stone_damaged.png`: damaged texture (cracks, scorch) for the same UVs; works on every group set.\n\n## Hit box\n\n- 16 x 128 x 16 centred at the origin"}