95788905363","6859e443-71c2-5708-bf25-7f0086c7fc9b","23135624-4244-519b-9c96-c1a82e1f3c1b","1fdb84e5-8e9d-577f-8d2a-e780741b0d3d","5b4388da-4afe-529b-a074-7a4503426f40","56f6de75-4981-508b-8537-6eb8460d361d","8c574995-ac9d-52f5-9605-ed5039897300","3a0afe88-1443-5906-a770-e471a8ae8672","c1a41512-b398-5ac4-85f5-9b1f1400f530","f489025a-d9d8-52a7-8885-4aab203be0b0","dddb0ad2-e89e-5be7-a355-da36d77cb856","29a89014-ef9f-56ff-adcb-f9ddeb297790","ed3d00a5-50b2-5d11-8a79-a5434c419630","adac47a1-380e-53c5-982a-a2f9f8db8c01","b7eb6166-7f8f-56fe-88c6-b00045a9347f","8b6523a1-42ba-5d2a-915b-92d124e8481b","390a9117-5839-52b2-9224-37c001bc4488","6427feac-8783-58cc-967e-59226c028c55"]},{"name":"ruined","origin":[0.0,0.0,0.0],"color":0,"uuid":"4d469ce5-34af-572f-b458-73c779817fb9","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":false,"autouv":0,"rotation":[0,0,0],"children":["799df93a-c440-570d-bfa5-5f951fc9fa95","eb31bcaa-3e84-534c-af69-a01e91b6f058","e5b7f55c-dfbe-576a-9a52-2fe9f3644444","6d43db6b-6a37-59d7-9a55-3de08e994f86","8a869ac4-220f-546a-96a7-c47c0e3e3692","d9f730c2-4dfa-5682-b6c1-691240a2b60c"]}]}],"textures":[{"path":"wall_corner_stone.png","name":"wall_corner_stone.png","folder":"","namespace":"","id":"0","width":64,"height":256,"uv_width":64,"uv_height":256,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"7cf616bf-4477-5fc8-9e32-9473611af044","relative_path":"wall_corner_stone.png","source":"data:image/png;base64,"}],"animations":[],"description":"# wall_corner_stone\n\nStone wall corner: an L joint filling one column; walls leave along -X... +X (north face) and along +Z (west face), with a corner post.\n\n- Footprint: 1 x 1 columns (16 x 16 units, 0.45 x 0.45 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -9..8, y 0..128, z -9..8 units.\n- Texture: 64 x 256, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 5, construction_0 15, construction_33 25, construction_66 27, ruined 6 (0 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- 16 x 128 x 16 centred at the origin\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `wall_corner_stone_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `wall_corner_stone_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_wall_corner_stone` together with the `ruined` set or the finished set.\n"}