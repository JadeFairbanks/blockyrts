"143bb5b0-0ab4-5d06-8dac-0a0973dff660","isOpen":false,"children":[]},{"uuid":"ccbacd0a-93b3-56b7-9cc6-5196a9cd8921","isOpen":false,"children":[]},{"uuid":"4ff89efe-7327-529e-82e0-79ec5cdbd2af","isOpen":false,"children":[]},{"uuid":"cd14e479-5c22-5088-b6d9-0d2912728b55","isOpen":false,"children":[]},{"uuid":"d540cdf7-8219-5bc6-b957-7bb29dc0538b","isOpen":false,"children":[]}]}],"textures":[{"name":"tower_stone.png","path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":512,"height":256,"uv_width":512,"uv_height":256,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"765c40da-caaa-5cd0-970d-b0d99b70b2dd","source":"data:image/png;base64,","relative_path":""}],"description":"# tower_stone\n\nStone tower: a 3 x 3 column platform for ranged units, with a parapet and four standing points (`slot_tower_1..4`), a ladder or stair door at the back.\n\n- Footprint: 3 x 3 columns (48 x 48 units, 1.35 x 1.35 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -26..26, y 0..179, z -26..26 units.\n- Texture: 512 x 256, 1 px per unit, square pixels, nearest filtering, flat pixel-art tones per material (repainted in Patch 5 for colour contrast).\n- Cubes: 41, all in `finished`; the construction and ruined state sets and the damaged/abandoned texture variants were removed in Patch 5 (the game draws none of them for buildings).\n\n## Hit box\n\n- 48 x 178 x 48 centred at the origin\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, 32)\n- `slot_tower_1` at (-12, 171, -12)\n- `slot_tower_2` at (12, 171, -12)\n- `slot_tower_3` at (-12, 171, 12)\n- `slot_tower_4` at (12, 171, 12)"}