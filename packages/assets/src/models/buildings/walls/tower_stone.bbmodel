":["c87efc62-8daf-5c14-8176-c0f442f661c4","787e572c-dc94-5724-9f32-ac53def6f703","c306ff47-e090-5990-99da-737e091ee452","4759dc16-3863-5d7e-beec-63d8eedaf0e9","9da286f9-bf47-5ec3-8eaa-cc8ffd7490fa","8480aa0e-5f03-518f-a3dd-eaadce44e4bb","f764fef4-af91-5de1-b948-5a3476cf3a02"]},{"name":"slot_door","origin":[0.0,0.0,32.0],"color":0,"uuid":"143bb5b0-0ab4-5d06-8dac-0a0973dff660","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_tower_1","origin":[-12.0,171.0,-12.0],"color":0,"uuid":"ccbacd0a-93b3-56b7-9cc6-5196a9cd8921","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_tower_2","origin":[12.0,171.0,-12.0],"color":0,"uuid":"4ff89efe-7327-529e-82e0-79ec5cdbd2af","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_tower_3","origin":[-12.0,171.0,12.0],"color":0,"uuid":"cd14e479-5c22-5088-b6d9-0d2912728b55","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_tower_4","origin":[12.0,171.0,12.0],"color":0,"uuid":"d540cdf7-8219-5bc6-b957-7bb29dc0538b","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"tower_stone.png","name":"tower_stone.png","folder":"","namespace":"","id":"0","width":256,"height":256,"uv_width":256,"uv_height":256,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"765c40da-caaa-5cd0-970d-b0d99b70b2dd","relative_path":"tower_stone.png","source":"data:image/png;base64,"}],"animations":[],"description":"# tower_stone\n\nStone tower: a 3 x 3 column platform for ranged units, with a parapet and four standing points (`slot_tower_1..4`), a ladder or stair door at the back.\n\n- Footprint: 3 x 3 columns (48 x 48 units, 1.35 x 1.35 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -26..26, y 0..179, z -26..26 units.\n- Texture: 256 x 256, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 42, construction_0 15, construction_33 32, construction_66 39, ruined 7 (0 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- 48 x 178 x 48 centred at the origin\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `tower_stone_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `tower_stone_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_tower_stone` together with the `ruined` set or the finished set.\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (0, 0, 32)\n- `slot_tower_1` at (-12, 171, -12)\n- `slot_tower_2` at (12, 171, -12)\n- `slot_tower_3` at (-12, 171, 12)\n- `slot_tower_4` at (12, 171, 12)\n"}