9c4a59ff5eb","4a452900-9a81-d631-8d28-e5bc1e3d2126","3d9a990f-8da6-204b-7018-8d14d4d53cfa","220ae7a9-11b9-3836-f786-2230fd596608","437ce518-54ae-c51b-0042-d71f95787a0c","280da959-346d-def6-84b8-e6cbacfa0e58","03f10c54-550b-b4f3-7e46-61066d585070","29cecedb-5448-6d0f-df41-41cc5f8c0b43","2d38a180-f594-a18a-401d-f6f8e44b0202","d4b04b3b-ec02-74d9-4df5-77a086e29ddd","8e699243-7173-6895-0da4-03508c27eb30","b2d257fa-fb6e-b560-0ca1-e231a3e1265a"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"textures":[{"name":"wall_stone.png","path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":256,"height":256,"uv_width":256,"uv_height":256,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"4d226bf2-6b26-5a67-8b4d-4114a85ef7c7","source":"data:image/png;base64,","relative_path":""}],"description":"# wall_stone\n\nStone wall: a straight segment one column (16 u) long along X, outer face toward -Z. End caps at both ends meet the next segment's cap to form a joint post. Stone: grey blocks, 3.6 m (128 u), one merlon, a walkway on top.\n\n- Footprint: 1 x 1 columns (16 x 16 units, 0.45 x 0.45 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -8..8, y 0..128, z -9..10 units.\n- Texture: 256 x 256, 1 px per unit, square pixels, nearest filtering, flat pixel-art tones per material (repainted in Patch 5 for colour contrast).\n- Cubes: finished 6, construction_0 18, construction_33 24, construction_66 23, ruined 28 (the state sets are cut from the finished cubes and map into the texture regions of the faces they were cut from).\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and footing with materials waiting, then walls rising inside scaffold).\n- `ruined`: broken walls at uneven heights, rubble and fallen beams.\n- `wall_stone_damaged.png`: damaged texture (cracks, scorch) for the same UVs; works on every group set.\n\n## Hit box\n\n- 16 x 128 x 16 centred at x 0, z 0\n\n## Attachment and effect points (empty groups)\n\n- `slot_wall_walk` at (0, 119, 2)"}