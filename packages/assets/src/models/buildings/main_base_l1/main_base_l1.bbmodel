b8e7-b6421915b507","46f9f834-574a-50c4-9d31-53cc1c9f56a6","559a6d0f-8a87-59b6-99fb-2588847c55ab","6d2075a0-f7c8-5417-b2b2-1838287cdfa2","ae19ea2b-28e2-5de9-938f-3da3d4489ae0","ffa34d36-db42-5f5b-b366-3b55699f74d7","36325331-a20e-514d-9ab7-142bd1cb836f","7b54cd92-343a-5499-9a26-1b3c93feae14","1d8ed260-926b-539a-b295-c640b74f9784"]},{"name":"slot_door","origin":[-24.0,0.0,-65.0],"color":0,"uuid":"bfddd0b7-5107-5d5a-818e-3aac9ab17ab4","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"slot_dropoff","origin":[6.0,0.0,-70.0],"color":0,"uuid":"bcf0311b-c708-50d7-ad2e-195128dbed4e","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"fx_smoke","origin":[-24.0,136.0,18.0],"color":0,"uuid":"4adc1de9-4c1e-5bc2-8d4b-e51bed931b91","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]},{"name":"fx_flame","origin":[52.0,12.0,-70.0],"color":0,"uuid":"10eeecc4-7730-5122-857b-269614d376b2","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":[]}]}],"textures":[{"path":"main_base_l1.png","name":"main_base_l1.png","folder":"","namespace":"","id":"0","width":512,"height":512,"uv_width":512,"uv_height":512,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"15a97f9a-e468-5a75-b04d-db397b8e975a","relative_path":"main_base_l1.png","source":"data:image/png;base64,"}],"animations":[],"description":"# main_base_l1\n\nMain base level 1, Big House: a long log hut with a steep thatched roof, a smoke hole and a wide door in the front gable. Firewood along the east wall, a campfire in the yard, and walk-through clutter (woodpiles, rail fence, lean-to, barrels) filling the rest of the 14 x 14 footprint.\n\n- Footprint: 14 x 14 columns (224 x 224 units, 6.30 x 6.30 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -112..112, y 0..135, z -112..112 units.\n- Texture: 512 x 512, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 139, construction_0 28, construction_33 33, construction_66 58, ruined 46 (8 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- house: 92 x 128 x 140 (w x h x d) centred at x -24, z 8\n- firewood rack: 18 x 32 x 124 at x 25, z 4 (optional; walk-through clutter otherwise)\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `main_base_l1_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `main_base_l1_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_main_base_l1` together with the `ruined` set or the finished set.\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (-24, 0, -65)\n- `slot_dropoff` at (6, 0, -70)\n- `fx_smoke` at (-24, 136, 18)\n- `fx_flame` at (52, 12, -70)\n\n## Notes\n\n- Walkable clutter (tag yard: fence, woodpiles, barrels, lean-to, campfire) sits on the unused footprint; units may walk through it.\n- Door 34 u wide x 80 u tall (2.25 m), in the north gable. Smoke hole hood on the ridge over the hearth (fx_smoke).\n"}