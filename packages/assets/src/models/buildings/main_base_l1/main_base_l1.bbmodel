d":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[-50,30.3,76.8],"rotation":[0,0,0],"color":0,"children":[],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},{"name":"fx_window_5","uuid":"791df622-6b45-21c8-a776-0dc3bf86efa5","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[2,30.3,76.8],"rotation":[0,0,0],"color":0,"children":[],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},{"name":"fx_window_6","uuid":"b0f93efc-b032-a6b2-0b4d-c799a874b69f","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[-56,30.3,-61.2],"rotation":[0,0,0],"color":0,"children":[],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},{"name":"fx_window_loft","uuid":"327c77d9-3e0e-3565-2a31-554d67ea3c60","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[-24,97.3,-60.5],"rotation":[0,0,0],"color":0,"children":[],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},{"name":"fx_window_loft_s","uuid":"d8a8b379-c51e-ecc5-745c-95d4224e0361","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[-24,97.3,76.5],"rotation":[0,0,0],"color":0,"children":[],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},{"name":"fx_fire","uuid":"0c39b36e-fd50-45ea-af92-7ca069fdfcb8","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[52,12,-70],"rotation":[0,0,0],"color":0,"children":[],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"textures":[{"name":"main_base_l1.png","path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":1024,"height":1024,"uv_width":1024,"uv_height":1024,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"15a97f9a-e468-5a75-b04d-db397b8e975a","source":"data:image/png;base64,","relative_path":""}],"description":"# main_base_l1\n\nMain base level 1, Big House: a long log hut with a steep thatched roof, a smoke hole and a wide door in the front gable. Firewood along the east wall, a campfire in the yard, and walk-through clutter (woodpiles, rail fence, lean-to, barrels) filling the rest of the 14 x 14 footprint.\n\nRemade in Patch 5 with the same layout and much more detail: log-cabin courses with ringed corner ends on a cobble footing, a long-eave thatch roof with eave and ridge rolls, gable horns and a louvred smoke vent, an iron-strapped double door with lanterns, eight lit windows with shutters, and a lived-in yard (firewood shed, campfire with spit and pot, lean-to workshop, well, garden with a scarecrow, barrels, crates, hay, a team pennant). The spit and roast over the yard campfire are their own bone, `spit_roast` (pivot on the spit rod), so the game can turn it without stopping.\n\nRemade in Patch 5 with the same layout and much more detail: log-cabin courses with ringed corner ends on a cobble footing, a long-eave thatch roof with eave and ridge rolls, gable horns and a louvred smoke vent, an iron-strapped double door with lanterns, eight lit windows with shutters, and a lived-in yard (firewood shed, campfire with spit and pot, lean-to workshop, well, garden with a scarecrow, barrels, crates, hay, a team pennant).\n\n- Footprint: 14 x 14 columns (224 x 224 units, 6.30 x 6.30 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -112..112, y -2..146, z -114..112 units.\n- Texture: 1024 x 1024, 1 px per unit, square pixels, nearest filtering, flat pixel-art tones per material.\n- Cubes: 602, all in `finished`; no hidden state sets (the construction and ruined sets and the damaged/abandoned texture variants were removed in the Patch 5 remake; the game draws none of them for buildings).\n\n## Hit box\n\n- house: 92 x 128 x 140 (w x h x d) centred at x -24, z 8\n- firewood rack: 18 x 32 x 124 at x 25, z 4 (optional; walk-through clutter otherwise)\n\n## Notes\n\n- Walkable clutter (tag yard: fence, woodpiles, barrels, lean-to, campfire) sits on the unused footprint; units may walk through it.\n- Door 34 u wide x 80 u tall (2.25 m), in the north gable. Smoke hole hood on the ridge over the hearth (fx_smoke).\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (-24, 0, -65)\n- `slot_dropoff` at (6, 0, -70)\n- `fx_smoke` at (-24, 136, 18)\n- `fx_flame` at (52, 12, -70)\n- `fx_window_1` at (-68.8, 30.3, -26)\n- `fx_window_2` at (-68.8, 30.3, 8)\n- `fx_window_3` at (-68.8, 30.3, 42)\n- `fx_window_4` at (-50, 30.3, 76.8)\n- `fx_window_5` at (2, 30.3, 76.8)\n- `fx_window_6` at (-56, 30.3, -61.2)\n- `fx_window_loft` at (-24, 97.3, -60.5)\n- `fx_window_loft_s` at (-24, 97.3, 76.5)\n- `fx_fire` at (52, 12, -70)"}