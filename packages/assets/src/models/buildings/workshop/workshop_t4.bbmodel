ht":1024,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"e8864454-729c-5a16-83a0-7e3f4f6ca14a","relative_path":"workshop_t4.png","source":"data:image/png;base64,"}],"animations":[{"uuid":"98b202ca-3901-54e7-be34-16a732f3ea98","name":"working","loop":"loop","override":false,"length":5.0,"snapping":24,"selected":false,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"cae45c21-d4b5-556c-83c9-0f59a000a1de":{"name":"wheel","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"eac6bc20-5930-522d-971c-c138b3464d77","time":0,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":90.0,"y":0.0,"z":0.0}],"uuid":"4995c66e-09f0-519e-86c6-64c99801d4c6","time":1.25,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":180.0,"y":0.0,"z":0.0}],"uuid":"db374b58-fd92-5ec4-80b4-4a30ce542fcf","time":2.5,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":270.0,"y":0.0,"z":0.0}],"uuid":"40626bfc-7c1b-50de-bf74-5d02cf1c5c6a","time":3.75,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":360.0,"y":0.0,"z":0.0}],"uuid":"5d29251d-6652-598c-adf5-38c0abf6de8d","time":5.0,"color":-1,"interpolation":"linear"}]}}}],"description":"# workshop_t4\n\nManufactory (tier 4): a long stone building with many windows, three chimneys and a waterwheel on a mill race at the east end.\n\n- Footprint: 14 x 8 columns (224 x 128 units, 6.30 x 3.60 m), centred on the origin, front (door side) faces -Z.\n- Finished bounds: x -102..110, y -0..198, z -60..60 units.\n- Texture: 256 x 1024, 1 px per unit, square pixels, nearest filtering. Every visible face has its own texture region painted with its material at world position (seams line up across faces); identical faces share a region; construction and ruined pieces map into the region of the face they were cut from. No cube is cut to fit the texture.\n- Cubes: finished 140, construction_0 33, construction_33 51, construction_66 67, ruined 34 (6 rotated: roof slabs and a few leaning props).\n\n## Hit box\n\n- manufactory: 172 x 190 x 76 centred at x -12, z 4\n- wheel: 14 x 80 x 80 at x 92, z 0\n\n## State group sets (children of `root`; show exactly one)\n\n- `finished`: the finished building (visible by default).\n- `construction_0`, `construction_33`, `construction_66`: build progress at 0 %, 33 % and 66 % (staked outline and scaffold, then walls rising inside scaffold, then full frame with roof rafters).\n- `ruined`: collapsed shell, broken walls, rubble, fallen roof (use with `_damaged.png`, or `_abandoned.png` for F7 abandoned buildings).\n- `workshop_t4_damaged.png`: damaged texture (scorch, holes, cracks) for the same UVs; works on every group set.\n- `workshop_t4_abandoned.png`: abandoned look (damage plus moss, faded cloth, cold fires) = `abandoned_workshop_t4` together with the `ruined` set or the finished set.\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `working` | 5.0 | loop | `wheel` turns once per 5 s. |\n\n## Attachment and effect points (empty groups)\n\n- `slot_door` at (-60, 0, -41)\n- `fx_smoke` at (-70, 199, 4)\n- `fx_smoke_2` at (-20, 199, 4)\n- `fx_smoke_3` at (30, 199, 4)\n- `slot_dropoff` at (-60, 0, -46)\n"}