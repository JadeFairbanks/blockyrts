29-df66d10c162b","time":2.0208,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"22.0424","y":"9.032","z":"6.8349"}],"uuid":"18724fe1-5224-5148-ba4a-df1454504eb0","time":2.0833,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"21.4572","y":"9.1288","z":"6.6568"}],"uuid":"abadec79-2252-5a32-83dd-ee86144fd85f","time":2.1042,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"20.4868","y":"9.2793","z":"6.3313"}],"uuid":"cdc4ccc1-7678-5843-a6ed-7ef91eeb4cda","time":2.1458,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"19.6044","y":"9.4033","z":"5.9924"}],"uuid":"6bc1eddc-2e13-51e8-ac29-0124fb9ccc82","time":2.2083,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"19.4333","y":"9.4246","z":"5.9176"}],"uuid":"61bf06b2-eb71-58f1-9276-6b037b443b74","time":2.25,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"## heavy_knight_body\n\nThe Dreadnought's body (Patch 7).\n\n- Cubes: 69 (0 rotated). Texture 256x256, mostly 2 px per unit as heavy_knight, embedded.\n- Bounds at rest: x -22.0..22.0, y 0.0..90.0, z -9.0..8.8 (size 44.0 x 90.0 x 17.8 u = 124 x 253 x 50 cm).\nThe Dreadnought's body without his plate and without his mace, split from `heavy_knight` (left unchanged). Every group of heavy_knight is kept with the same names, origins and nesting, including `pauldron_r/l`, `pauldron_lame_r/l`, the four `skirt_*` groups and every `slot_*`; a group whose cubes all moved to `armour_dreadnought_harness` stays as an empty group, and the `mace` group (with `slot_mace_head` and `slot_mace_grip_l`) is gone, so `slot_hand_r` is empty. His helmet and plume stay on the body. Under the plate he wears a padded arming doublet (`doublet`, half a unit inside the breastplate so it never shows through it) and dark hose on the thighs, where heavy_knight has bare skin that the plate skirt hides. All nine clips (`idle`, `walk`, `run`, `attack_smash`, `attack_swing`, `injured`, `death`, `warcry`, `jump`) are heavy_knight's, unchanged, except that `death`'s keys for the mace moved to `dreadnought_mace_held`'s own `death` clip. Body plus `armour_dreadnought_harness` plus `dreadnought_mace_held` at `slot_hand_r` is heavy_knight cube for cube, apart from the doublet and the hose. Patch 7.\n"}