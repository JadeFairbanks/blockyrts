hips` at (-5.5, 37, 2)\n\n## Preview / carried items in slots\n\n- `living_staff` (visible, under slot_hand_r): about 1.8 m (64 u), grip at the origin, top (glowing seed) 40 u along item -Z, butt 24 u along +Z. The `glow_seed` cube is the glowing seed (light it in game)\n\n## Second grips (two-handed items)\n\n- cast_rootbind: second grip (left hand) 12 u above the right hand on the staff\n\n## Variant textures (same UV layout)\n\n- `elf_grovesinger_silver.png`: silver hair\n- `elf_grovesinger_gold.png`: pale gold hair\n- `elf_grovesinger_black.png`: black hair\n","resolution":{"width":128,"height":128},"elements":[{"name":"pelvis","box_uv":false,"rescale":false,"locked":false,"light_emission":0,"render_order":"default","allow_mirror_modeling":true,"from":[-4.5,34.0,-2.5],"to":[4.5,38.0,2.5],"autouv":0,"color":0,"inflate":0.0,"origin":[0.0,34.0,0.0],"faces":{"north":{"uv":[11,70,20.0,74.0],"texture":0},"east":{"uv":[43,70,48.0,74.0],"texture":0},"south":{"uv":[20,70,29.0,74.0],"texture":0},"west":{"uv":[48,70,53.0,74.0],"texture":0},"up":{"uv":[66,63,75.0,68.0],"texture":0},"down":{"uv":[75,63,84.0,68.0],"texture":0}},"type":"cube","uuid":"8f6efb09-d7b8-5fb1-b4bd-df63fdb0fe83"},{"name":"chest","box_uv":false,"rescale":false,"locked":false,"light_emission":0,"render_order":"default","allow_mirror_modeling":true,"from":[-5.5,38.0,-2.5],"to":[5.5,56.0,2.5],"autouv":0,"color":0,"inflate":0.0,"origin":[0.0,38.0,0.0],"faces":{"north":{"uv":[24,0,35.0,18.0],"texture":0},"east":{"uv":[46,0,51.0,18.0],"texture":0},"south":{"uv":[35,0,46.0,18.0],"texture":0},"west":{"uv":[51,0,56.0,18.0],"texture":0},"up":{"uv":[44,63,55.0,68.0],"texture":0},"down":{"uv":[55,63,66.0,68.0],"texture":0}},"type":"cube","uuid":"7ceb6698-ecc0-56b6-8439-4dfefcd46a06"},{"name":"neck","box_uv":false,"rescale":false,"locked":false,"light_emission":0,"render_order":"default","allow_mirror_modeling":true,"from":[-1.5,56.0,-1.5],"to":[1.5,60.0,1.5],"autouv":0,"color":0,"inflate":0.0,"origin":[0.0,56.0,0.