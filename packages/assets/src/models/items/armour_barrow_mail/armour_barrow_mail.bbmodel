mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"textures":[{"name":"armour_barrow_mail.png","path":"","relative_path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":128,"height":64,"uv_width":128,"uv_height":64,"particle":false,"use_as_default":false,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":false,"uuid":"390f1a1a-0453-3bc5-ad12-4965eee42280","source":"data:image/png;base64,"}],"description":"## armour_barrow_mail\n\nArmour, worn by troops (Patch 7 loot).\n\n- Cubes: 9 (0 rotated). Texture 128x64, 1 px per unit, embedded.\n- Bounds at rest: x -11.4..11.4, y 19.0..64.0, z -5.1..4.7 (size 22.8 x 45.0 x 9.8 u = 64 x 127 x 28 cm).\nThe barrow knight's rusted mail and great helm (`barrow_knight.bbmodel`: `hauberk`, `mail_sleeve_r/l`, `mail_skirt_r/l`, `great_helm`, `crest`), redrawn to fit warrior_base: the great helm (closed, with its eye slit) and crest on `head`; the hauberk on `torso`; mail sleeves on `arm_upper_r/l`; mail over the hips on `hips`; the mail skirt split in two on `leg_upper_r/l`, as on the knight, so the legs never pass through it. Every face is resampled from the barrow knight's own texture at 1 px per unit. The knight's belt is the team-colour sash (`team_sash`, RGB 52, 96, 178), as on the ladder armour. Same bones and pivots as warrior_base. Patch 7 loot.\n"}