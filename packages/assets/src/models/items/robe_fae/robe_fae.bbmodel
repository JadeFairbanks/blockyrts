,45,0],"rotation":[0,0,0],"color":0,"children":["248cbaad-74b1-86b1-d07a-eedd21d77226"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},{"name":"arm_upper_l","uuid":"25503e36-7fa7-08cc-c342-505e14b7d884","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[-7.5,45,0],"rotation":[0,0,0],"color":0,"children":["515e117b-e189-ca19-9b3d-86e898dfa71d"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},"f3fac018-8cb1-61ef-6429-dd432222d19c","d4b8c75a-67a7-5582-6cff-0ae9ce70f2c7","3c6a082d-5bf0-70c9-b586-2235fec87e60"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},{"name":"leg_upper_r","uuid":"bf9c79dc-4d36-f0b2-71bc-9fce14afca89","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[3,26,0],"rotation":[0,0,0],"color":0,"children":["dd87a2bd-b69c-34e0-1448-67207175e1d2"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},{"name":"leg_upper_l","uuid":"5571a388-97b6-4f41-f93d-bb2bb6ec70cd","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[-3,26,0],"rotation":[0,0,0],"color":0,"children":["0e6fa2d9-6b7f-3691-89af-d5fb45ca63b1"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},"f65c8ac7-5663-67ba-32b3-500253642bf2","d67bf8eb-82e2-4106-8470-ce5b8936ea00"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"textures":[{"name":"robe_fae.png","path":"","relative_path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":128,"height":64,"uv_width":128,"uv_height":64,"particle":false,"use_as_default":false,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":false,"uuid":"120e42fa-5d49-940e-4752-330f16005876","source":"data:image/png;base64,"}],"description":"## robe_fae\n\nRobe, worn by mages (Patch 7 loot).\n\n- Cubes: 9 (0 rotated). Texture 128x64, 1 px per unit, embedded.\n- Bounds at rest: x -9.4..9.4, y 14.2..47.3, z -5.2..4.9 (size 18.8 x 33.1 x 10.2 u = 53 x 93 x 29 cm).\nThe Fae Guardian's dress (`fairy.bbmodel`: `chest`, `chest_bust` (`bust`, `bust_front`), `hips_dress`, `skirt` (`skirt_upper`, `skirt_hem`)), remade as a mage's robe in the same colours and pattern, to fit mage_base, one look on every mage: the dress over the torso and bust with short sleeves; its dark band under the bust as the team-colour sash (`team_sash`, RGB 52, 96, 178, where the fairy has her own `team_sash`); and the flared skirt on `hips` with its hem on the thighs (`leg_upper_r/l`), stopping above the knee as the fairy's does. The fairy's blue skin is left out of the sampled faces. Every face is resampled from the fairy's own texture at 1 px per unit. Same bones and pivots as mage_base. Patch 7 loot.\n"}