e472","d0372ee6-2963-55d0-b07a-5bb1b097df31","38076cbd-585d-5e85-b072-66d7e4376a6d","dcc7bbbb-3495-54cd-a326-644f56acc45f","b6edeb24-02be-5eb6-a2d1-0e6006e21523"]},{"name":"slot_grip","origin":[0,0,0],"rotation":[0,0,0],"uuid":"abb71642-c632-4a5f-beae-942b93678969","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"children":[]}]}],"textures":[{"path":"","name":"staff_necromancer.png","folder":"","namespace":"","id":"0","width":256,"height":64,"uv_width":256,"uv_height":64,"particle":false,"use_as_default":false,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"bc033c69-3b2d-41c3-98aa-545f5115ee89","relative_path":"","mode":"bitmap","source":"data:image/png;base64,"}],"animations":[],"description":"## staff_necromancer\n\nStaff cut from the necromancer's `staff`, held by the mage in the right hand (Patch 7, item 36).\n\nCut from `necromancer.bbmodel` as made, no redraw: the grip is at the origin with an empty `slot_grip` there, under `root`, and the piece points along -Z from the grip. Its rest tilt in the necromancer's hand is dropped so it lies along -Z.\n\nResized (Patch 7 weapons review): scaled to 54% about the grip, from 135 cm to 72 cm, so a mage can carry it; the scale is the square root of the mages' archstaff (39 cm) over its cut length, so heavier pieces stay larger than lighter ones. Then slid 2.5 units (7 cm) along +Z, so the hand holds it a little below its head and the head clears the mage's face in `cast_bolt`.\n\n- Clips: `cast_bolt`, `cast_beam`, `cast_heal`, `cast_area`.\n- Length: 72 cm (cut at 135 cm).\n- Cubes: 6.\n- Texture: 256x64, the monster's own sheet cropped to the faces used."}