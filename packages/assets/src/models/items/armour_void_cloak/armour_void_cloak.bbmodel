,"isOpen":false,"primary_selected":false},{"name":"arm_upper_r","uuid":"121afffc-32e3-469f-e59d-57dd7679cc66","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[9,48,0],"rotation":[0,0,0],"color":0,"children":["9542beae-bd3a-6987-1082-8eaa2b2c049a"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},{"name":"arm_upper_l","uuid":"cc857ae9-9c8a-3c34-0bdb-2a6347f9d76e","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[-9,48,0],"rotation":[0,0,0],"color":0,"children":["d3b6d8a5-c26b-da9e-ec86-0fc9b09678d1"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},"6c0eea91-d9aa-06cb-122b-02fe99768e30","89b3a0ff-941b-0c96-6869-87da3f9b1162","4d70fa9a-b5c9-4f4d-7c71-bc2abc3c2fc4"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},{"name":"leg_upper_r","uuid":"25f1c977-a1ad-d1e8-6ca7-d8cf1470218b","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[3,28,0],"rotation":[0,0,0],"color":0,"children":["8b014ddd-67fa-d5e9-ce81-19fb784692c2"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},{"name":"leg_upper_l","uuid":"761e11d9-63dc-575a-e8ba-3c894729448c","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[-3,28,0],"rotation":[0,0,0],"color":0,"children":["eae6063e-6d3b-25a8-64e6-aa3b665d4767"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"textures":[{"name":"armour_void_cloak.png","path":"","relative_path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":64,"height":64,"uv_width":64,"uv_height":64,"particle":false,"use_as_default":false,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":false,"uuid":"acd43321-93ed-04cb-3e8c-5ec04c67bc0b","source":"data:image/png;base64,"}],"description":"## armour_void_cloak\n\nArmour, worn by troops (Patch 7 loot).\n\n- Cubes: 12 (0 rotated). Texture 64x64, 1 px per unit, embedded.\n- Bounds at rest: x -11.6..11.6, y 17.5..61.8, z -5.9..5.7 (size 23.2 x 44.3 x 11.6 u = 65 x 125 x 33 cm).\nThe void stalker's hooded cloak (`void_stalker.bbmodel`: `hood`, `hood_rim`, `cloak_back`), redrawn to fit warrior_base, with no armour plates: an open hood (top, back, sides and the front brim, the face left showing) on `head`; a mantle across the shoulders, the cloak's upper part and a small team-colour clasp (`team_clasp`, RGB 52, 96, 178) on `torso`; shoulder drapes on `arm_upper_r/l`; and the cloak's lower part, with its torn hem, split in two on `leg_upper_r/l`, so the legs never cut through it. Every face is resampled from the void stalker's own texture at 1 px per unit. The tails stop above the knee; in the deepest heel kick of `run` and in `death` the calf passes behind a tail for a few frames. Same bones and pivots as warrior_base. Patch 7 loot.\n"}