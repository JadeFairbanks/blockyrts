-6648-e199-df50f54f0604","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[-3,26,0],"rotation":[0,0,0],"color":0,"children":[{"name":"leg_lower_l","uuid":"0864b62a-af5e-d294-8b7e-890563e74153","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[-3,13,0],"rotation":[0,0,0],"color":0,"children":["4e1fdf7e-5bd8-8d42-a135-5f48ef9fd42e"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},"82a2b1dc-34df-90f4-7acb-9e5986787c73"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},"5932984e-1c06-5f1d-b7ad-99f3aafcc502","bcd2849f-38de-bd67-57e8-7c2938d4a985","cea2740a-54db-3f42-9fc3-469cb08ff2ee"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"textures":[{"name":"robe_necromancer.png","path":"","relative_path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":128,"height":64,"uv_width":128,"uv_height":64,"particle":false,"use_as_default":false,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":false,"uuid":"15198a78-d6aa-e317-d517-efe75a5fbc92","source":"data:image/png;base64,"}],"description":"## robe_necromancer\n\nRobe, worn by mages (Patch 7 loot).\n\n- Cubes: 22 (0 rotated). Texture 128x64, 1 px per unit, embedded.\n- Bounds at rest: x -9.7..9.7, y 5.5..60.9, z -5.2..5.6 (size 19.4 x 55.4 x 10.9 u = 55 x 156 x 31 cm).\nThe necromancer's robe and gold crown (`necromancer.bbmodel`: `robe_torso`, `gold_trim_chest`, `robe_waist`, `gold_sash`, `robe_skirt`, `sleeve_r/l`, `cuff_r/l`, `robe_cowl`, `crown_band` and its four points), redrawn as a mage's robe to fit mage_base, one look on every mage: the robe over the torso, the bust and both arms; the skirt on `hips`, over the mage's own skirt; and the lower robe on the thighs (`leg_upper_r/l`) and shins (`leg_lower_r/l`), so the legs never cut through it. Every face is resampled from the monster's own texture at 1 px per unit, so the colours and pixel style are its own. Same bones and pivots as mage_base. Patch 7 loot.\n"}