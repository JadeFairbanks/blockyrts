gin":[3,13,0],"rotation":[0,0,0],"color":0,"children":["f41edb6a-7a08-248a-17a3-7a32dc9fad1d"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},"3a70e7ea-1ab0-632a-26b4-9d6128e430f5"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},{"name":"leg_upper_l","uuid":"c9d6b949-bfb9-1b24-842e-bf8a8991fd34","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[-3,26,0],"rotation":[0,0,0],"color":0,"children":[{"name":"leg_lower_l","uuid":"c259c98b-4c5b-96db-841c-0dd660c8c136","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[-3,13,0],"rotation":[0,0,0],"color":0,"children":["27333ba9-cea6-e65b-83cb-2645af1452ab"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},"347570bc-8308-885d-884b-54028a501ba4"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},"9a1f52d5-3a08-5ff7-87dd-23602eeee6e6"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"textures":[{"name":"robe_plague_bearer.png","path":"","relative_path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":128,"height":64,"uv_width":128,"uv_height":64,"particle":false,"use_as_default":false,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":false,"uuid":"abf6b2e8-cb11-b9b3-8c9a-546c242abbc5","source":"data:image/png;base64,"}],"description":"## robe_plague_bearer\n\nRobe, worn by mages (Patch 7 loot).\n\n- Cubes: 19 (0 rotated). Texture 128x64, 1 px per unit, embedded.\n- Bounds at rest: x -9.4..9.4, y 5.5..63.6, z -13.4..7.0 (size 18.8 x 58.1 x 20.4 u = 53 x 163 x 57 cm).\nThe plague bearer's long coat and beaked mask (`plague_bearer.bbmodel`: `chest`, `hood_cape`, `robe_skirt`, `robe_hem_r/l`, the bandaged arms, `beak`, `beak_tip`, the green lenses `glow_eye_r/l`, and its wide hat `hat_brim` and `hat_crown`), redrawn as a mage's robe to fit mage_base, one look on every mage: the robe over the torso, the bust and both arms; the skirt on `hips`, over the mage's own skirt; and the lower robe on the thighs (`leg_upper_r/l`) and shins (`leg_lower_r/l`), so the legs never cut through it. Every face is resampled from the monster's own texture at 1 px per unit, so the colours and pixel style are its own. Same bones and pivots as mage_base. Patch 7 loot. The mask covers the mage's face.\n"}