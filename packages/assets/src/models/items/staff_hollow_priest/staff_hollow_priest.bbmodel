on":[0,0,0],"children":[]}]},{"name":"slot_grip","origin":[0,0,0],"rotation":[0,0,0],"uuid":"be0e82cb-6cb8-4aa0-82ce-ee1c2d410091","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"children":[]}]}],"textures":[{"path":"","name":"staff_hollow_priest.png","folder":"","namespace":"","id":"0","width":128,"height":128,"uv_width":128,"uv_height":128,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"161ed06c-3a97-42b6-af53-695f2b06fee3","relative_path":"","source":"data:image/png;base64,"}],"animations":[],"description":"## staff_hollow_priest\n\nStaff cut from the hollow priest's `crooked_staff`, held by the mage in the right hand (Patch 7, item 35).\n\nCut from `hollow_priest.bbmodel` as made, no redraw: the grip is at the origin with an empty `slot_grip` there, under `root`, and the piece points along -Z from the grip.\n\nResized (Patch 7 weapons review): scaled to 48% about the grip, from 172 cm to 82 cm, so a mage can carry it; the scale is the square root of the mages' archstaff (39 cm) over its cut length, so heavier pieces stay larger than lighter ones. Then slid 3.76 units (11 cm) along +Z, so the hand holds it a little below its head and the head clears the mage's face in `cast_bolt`.\n\n- Clips: `cast_bolt`, `cast_beam`, `cast_heal`, `cast_area`.\n- Length: 82 cm (cut at 172 cm).\n- Cubes: 5.\n- Texture: 128x128, the monster's own sheet cropped to the faces used."}