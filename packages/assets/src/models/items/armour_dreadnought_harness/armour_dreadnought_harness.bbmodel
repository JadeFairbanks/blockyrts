ity":true,"autouv":0,"rotation":[0,0,0],"children":["5c6b3ceb-0a4a-5da8-b859-8738bad996c0","28d49785-3c55-54be-938f-e0c9f0ca477f"]},{"name":"skirt_br","origin":[7,36,0],"color":3,"uuid":"202930bf-cfc4-5483-9de9-150e78a00161","export":true,"mirror_uv":false,"isOpen":true,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":["1980c9d6-e6d3-5d3c-8f31-c8073e31df64","9ba145b2-64cd-5741-9e38-7f735fec9c7f"]},{"name":"skirt_fl","origin":[-7,36,0],"color":3,"uuid":"3679d349-2689-53a7-8f5f-3b45f501e92f","export":true,"mirror_uv":false,"isOpen":true,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":["0924a209-b217-5ea2-8d0e-82c54157a135","cdb9a942-3f01-5802-bab8-361298f9141f"]},{"name":"skirt_bl","origin":[-7,36,0],"color":3,"uuid":"981f3529-406d-5b2b-9c72-f98f26d37bbd","export":true,"mirror_uv":false,"isOpen":true,"locked":false,"visibility":true,"autouv":0,"rotation":[0,0,0],"children":["7044405a-048f-5632-a7d5-71450276e4b1","13913932-8992-5053-b870-10f752dc3b83"]}]}]}],"textures":[{"path":"","name":"armour_dreadnought_harness.png","folder":"","namespace":"","id":"0","width":256,"height":128,"uv_width":256,"uv_height":128,"particle":false,"use_as_default":false,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"f4988756-2919-5ef7-97cb-d2f97ae5ee07","relative_path":"","mode":"bitmap","source":"data:image/png;base64,"}],"animations":[],"description":"## armour_dreadnought_harness\n\nArmour, the Dreadnought's tier 8 harness (Patch 7).\n\n- Cubes: 32 (0 rotated). Texture 256x128, 2 px per unit as heavy_knight, embedded.\n- Bounds at rest: x -25.5..25.5, y 22.0..65.5, z -9.0..9.0 (size 51.0 x 43.5 x 18.0 u = 143 x 122 x 51 cm).\nThe tier 8 harness in the Dreadnought's own look: heavy_knight's plate copied as it looks today, as a worn piece fitted to `heavy_knight_body`: the breastplate on `torso`, the mail pauldrons on `pauldron_r/l` with their lames on `pauldron_lame_r/l`, and the mail plate skirt on the four `skirt_*` bones, every cube in the bone it moves with. heavy_knight has no vambraces, gauntlets, greaves or sabatons (his forearms with leather bracers, his fists and his leather boots are the body's), so the harness has none either. Patch 7.\n"}