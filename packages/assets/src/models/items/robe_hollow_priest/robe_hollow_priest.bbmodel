"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[3,26,0],"rotation":[0,0,0],"color":0,"children":[{"name":"leg_lower_r","uuid":"d38241fc-1a8f-4f92-ce67-88a74f0e54b7","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[3,13,0],"rotation":[0,0,0],"color":0,"children":["bcaa4f39-cb88-108b-3905-6e1b2741a23d"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},"42c9b511-8a54-9cc2-b307-f35e864947b4"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},{"name":"leg_upper_l","uuid":"273b2267-00fb-f0b9-3775-8d409c7ec3d9","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[-3,26,0],"rotation":[0,0,0],"color":0,"children":[{"name":"leg_lower_l","uuid":"7312d609-748a-ee90-2f8c-9147be9e345c","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[-3,13,0],"rotation":[0,0,0],"color":0,"children":["19a2112d-1ba0-236f-8f37-d77d44b80047"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},"ffedb980-7456-5c72-10ea-8c3f8b3a150d"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},"e1684da1-c931-8fa1-537d-4a46a37d8dee"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"textures":[{"name":"robe_hollow_priest.png","path":"","relative_path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":128,"height":64,"uv_width":128,"uv_height":64,"particle":false,"use_as_default":false,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":false,"uuid":"f90bd961-990f-f4b4-7908-a3c0b1f385dd","source":"data:image/png;base64,"}],"description":"## robe_hollow_priest\n\nRobe, worn by mages (Patch 7 loot).\n\n- Cubes: 16 (0 rotated). Texture 128x64, 1 px per unit, embedded.\n- Bounds at rest: x -9.4..9.4, y 5.5..58.8, z -5.6..5.7 (size 18.8 x 53.3 x 11.3 u = 53 x 150 x 32 cm).\nThe hollow priest's robe and hood (`hollow_priest.bbmodel`: `chest`, `mantle`, `robe_skirt`, `robe_hem_r/l`, the arms, `hood`, `hood_brow`, `hood_side_r/l`), redrawn as a mage's robe to fit mage_base, one look on every mage: the robe over the torso, the bust and both arms; the skirt on `hips`, over the mage's own skirt; and the lower robe on the thighs (`leg_upper_r/l`) and shins (`leg_lower_r/l`), so the legs never cut through it. Every face is resampled from the monster's own texture at 1 px per unit, so the colours and pixel style are its own. Same bones and pivots as mage_base. Patch 7 loot. The hood is open at the front so the mage's face shows, and it covers her hair at the back.\n"}