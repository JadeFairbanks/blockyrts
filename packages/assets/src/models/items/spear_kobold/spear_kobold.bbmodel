583e2a-b6d1-4b15-a018-4a857154afe3"}],"outliner":[{"name":"root","origin":[0,0,0],"rotation":[0,0,0],"uuid":"42207f87-b89f-4ee3-b1fa-cd1015a68154","export":true,"mirror_uv":false,"isOpen":true,"locked":false,"visibility":true,"autouv":0,"children":[{"name":"gear_spear","origin":[0.0,0.0,-3.0],"rotation":[0,0,0],"color":3,"uuid":"92148aae-80e2-4594-b6f4-88286eff0a62","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"children":["4175df4c-0e59-4fac-92da-a0b477b8b3da","7a70e385-6cd1-4b0b-b7ae-a9431460d7f7","a56b7cc7-1bd8-4515-9f51-cdd9dcc5d4f6","07c8ebc8-8f8f-4da6-a679-012548bb0b56","467b557e-cd69-4795-a476-241f39d9e92b","79583e2a-b6d1-4b15-a018-4a857154afe3"]},{"name":"slot_grip","origin":[0,0,0],"rotation":[0,0,0],"uuid":"83261fc9-26d6-47bd-b422-1de838b55397","export":true,"mirror_uv":false,"isOpen":false,"locked":false,"visibility":true,"autouv":0,"children":[]}]}],"textures":[{"path":"","name":"spear_kobold.png","folder":"","namespace":"","id":"0","group":"","width":128,"height":128,"uv_width":128,"uv_height":128,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","pbr_channel":"color","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"6535f2c1-f6ea-4c8b-9ccb-59a3f77b8560","relative_path":"","source":"data:image/png;base64,"}],"animations":[],"description":"## spear_kobold\n\nSpear cut from the kobold's `gear_spear`, held by the warrior in the right hand (Patch 7, item 27).\n\nCut from `kobold.bbmodel` as made, no redraw: the grip is at the origin with an empty `slot_grip` there, under `root`, and the piece points along -Z from the grip. Cut at 16/9 of the monster's drawn size, the size Jade built it, so it is not toy-sized in a person's hand.\n\nReview fix (Patch 7 weapons review): the whole spear slid 3 units (8 cm) along -Z, so the off hand in `guard_polearm` and `attack_polearm_thrust` holds the shaft, not the binding; length and cubes unchanged.\n\n- Clips: `attack_polearm_thrust`, `guard_polearm`.\n- Length: 123 cm.\n- Cubes: 6.\n- Texture: 128x128, the monster's own sheet cropped to the faces used."}