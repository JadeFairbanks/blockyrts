d8a","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[-3,13,0],"rotation":[0,0,0],"color":0,"children":["92155974-54d2-eeff-5b8e-b740a8bd3c2e","99301f7e-1c10-6aed-f1b2-e17a37ef58cb","6e06bfd6-b253-8f8a-c17a-4f12fdedc34a","b936fef5-0514-c46e-3006-e4011bea0730","1e95925e-d107-0b23-9415-588d0541cc36"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},"e863a2c5-89a0-06f7-c7ec-3c936c5996bd"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},"55536c1f-2159-d928-cfa9-1c02c14b8f0a","2ce67e75-48f8-cacf-0cf7-cb77ad261e3a","f5ce3b1a-efc1-8af2-b8db-9d587cdc2689"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"textures":[{"name":"robe_lich.png","path":"","relative_path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":128,"height":128,"uv_width":128,"uv_height":128,"particle":false,"use_as_default":false,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":false,"uuid":"1ebd7212-c190-e029-8b5f-9134ade37434","source":"data:image/png;base64,"}],"description":"## robe_lich\n\nRobe, worn by mages (Patch 7 loot).\n\n- Cubes: 52 (14 rotated). Texture 128x128, 1 px per unit, embedded.\n- Bounds at rest: x -10.0..10.0, y 3.2..63.5, z -7.7..9.6 (size 20.0 x 60.3 x 17.3 u = 56 x 170 x 49 cm).\nThe Deathless Shroud: the lich's robe (`lich.bbmodel`: the torso cloth `chest_robe`, `inner_robe_front`, `band_44`, `band_50`, `glow_sigil_brand`, `mantle`, `mantle_hem`, `collar_back`, `collar_r/l` and three `collar_spine_spur_*`; `sleeve_r/l` with their `sleeve_tail_back_*`; `waist_wrap`, `waist_clasp`, `skirt_upper`, `skirt_mid`, `skirt_hem`; the hanging `strip_0` to `strip_7`; and its `crown`), remade as a mage's robe to fit mage_base, one look on every mage. The skirt's three tiers are on `hips`, the thighs and the shins, so the legs never cut through them, and the eight strips are separate cubes on the shins, hanging over the bottom tier, so they sway with the walk. The crown is the lich's ring of eight tilted bone fragments (every 45 degrees, tipped out 16 degrees as on the lich) with spikes on the sides and back, the skull face (brow ridge and eye sockets) on the front fragment and the red binding round the base, made smaller to sit on the mage's head; its cracks and teeth are left out. The floating crystal is left out. Every face is resampled from the lich's own texture at 1 px per unit, keeping its torn, cut-out edges (alpha). Same bones and pivots as mage_base. Patch 7 loot.\n"}