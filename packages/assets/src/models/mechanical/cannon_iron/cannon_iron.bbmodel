n_global":false,"quaternion_interpolation":false,"keyframes":[{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"eea5cab0-640e-5e05-aad3-4f6a4c501bfa","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"-10.8"}],"uuid":"4e373652-5f04-585f-8245-d96dbc364802","time":0.15,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"-90"}],"uuid":"7893abe4-c2b3-55ca-986d-9a0cb2ece45d","time":0.55,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"-83.7"}],"uuid":"6357eee9-3c2e-5203-afb4-d91df094d04f","time":0.68,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"-90"}],"uuid":"e4664315-09d0-5316-96c7-162a014c58ac","time":0.8,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"-90"}],"uuid":"96500a9c-6c65-548d-973a-852363f8b0f6","time":1.6,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"5b321df3-fb87-5d90-b064-6890b573eff3","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"30b758c3-69a3-544d-a9ab-e7960ff84ec5","time":0.15,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"22.5","y":"-17.25","z":"0"}],"uuid":"63043a80-a889-58ef-a2e4-896d03339dd0","time":0.55,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"21.825","y":"-16.733","z":"0"}],"uuid":"6fce6f74-24e1-501c-84b1-fb0a45b542d1","time":0.68,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"22.5","y":"-17.25","z":"0"}],"uuid":"7617c176-d132-5563-af7f-bd0d1ea0f65a","time":0.8,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"22.5","y":"-17.25","z":"0"}],"uuid":"3630787e-40dd-5996-89a4-4d7fdb9f0d4b","time":1.6,"color":-1,"interpolation":"catmullrom"}]},"4b7618b9-911f-53ec-aa5f-7eeee85ec37c":{"name":"wheel_l","type":"bone","rotation_global":false,"quaternion_interpolation":false,"keyframes":[{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"1ef1ea58-f7c3-55dc-aa59-2c4f22ff52f6","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"7.2"}],"uuid":"bf34286d-eae4-55cf-9355-c50368365007","time":0.25,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"-15","z":"90"}],"uuid":"7d17533f-905b-57fb-83e0-c9ea05ce9090","time":0.75,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"-14.7","z":"84.6"}],"uuid":"a0f8000c-3ca6-5556-9b2e-c2dc8182df7e","time":0.88,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"-15","z":"90"}],"uuid":"b4cde8ee-3451-5e67-a902-6dce62af8ecb","time":1,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"-15","z":"90"}],"uuid":"9c39168e-5f6e-539f-a5d3-d75a9b8cda48","time":1.6,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"b9d1296e-36b5-54a3-abcf-11ebbbcbd690","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"9647c049-dca0-52d3-ae48-683f3dd45411","time":0.25,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"-23.5","y":"-13.004","z":"4"}],"uuid":"943f6a7c-7af2-51e5-89ad-c7f0745929b7","time":0.75,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"-23.03","y":"-12.744","z":"3.92"}],"uuid":"f9c8759f-c599-5dff-b642-e2047b74eb57","time":0.88,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"-23.5","y":"-13.004","z":"4"}],"uuid":"abd8d2a8-1b69-5cd0-9ba3-ba5d41d9b2ed","time":1,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"-23.5","y":"-13.004","z":"4"}],"uuid":"fd77d29a-a948-5231-bb83-205b207eca83","time":1.6,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"## cannon_iron\n\nField cannon, iron (E1).\n\nRemade in Patch 5: a long, slimmer dark wrought-iron barrel with reinforce bands, a breech and cascabel, and a wide 7.5 u bore, so it reads at a glance as the bigger gun next to the bronze one. `slot_muzzle` marks the muzzle mouth for the flash, sparks and smoke.\n\n- Cubes: 60, all in `finished`; no hidden state sets (the construction and ruined sets and the damaged/abandoned texture variants were removed in the Patch 5 remake; the game draws none of them for buildings).\n- Bounds at rest: x -14.0..14.0, y 0.0..39.0, z -31.1..34.0 (size 28.0 x 39.0 x 65.1 u = 79 x 110 x 183 cm).\nField cannon: about 1.8 m long with the trail (65 u), barrel 1.2 m, wheels 1.1 m. Dark grey cast-iron barrel (1.2 m), plainer and a little thicker than the bronze gun (+1 u all round, no mouldings), on the same oak carriage with iron straps, team-colour stripe and 1.1 m spoked wheels.\nHauled field gun, faces -Z (muzzle forward), stands on y = 0 on its wheels and trail shoe.\n\n**Hit box:** one box 28 x 39 x 65 u (w x h x d), centred x = 0, z = 1, from y = 0.\n\n**Bones:** `root` > `carriage` (pivot at the trail shoe, so the fire hop rocks on the trail) > `barrel` (pivot at the trunnions, pitch = elevation; the game may set it directly to aim) > `fx_muzzle` (empty, at the muzzle mouth: spawn flash/smoke/ball here), `wheel_r`, `wheel_l` (pivots on the axle), `bucket` (sponge bucket).\n\n**Slots:** `slot_hitch` at the trail-end lunette (the limber or the animal's draw-bar hooks here; guns are towed trail-first), `slot_crew_1` = loader/rammer, standing 40 u in front of the muzzle, slightly right, facing +Z back toward the muzzle (the dwarf crew's `ram` key reaches ~40 u forward and ~20 u up), `slot_crew_2` = gunner beside the trail on the left, facing -Z. Crew slots sit on the ground (y = 0) and are children of `root` so they do not jump with the gun.\n\n**Move speed:** `move` is designed for 35.6 u/s (1.0 m/s, ox/horse walk): the wheels make one turn per 3.44 s (circumference 122.5 u). `move` rolls the wheels for travel toward -Z (muzzle first, crew man-handling it); `move_towed` rolls them the other way for travel toward +Z (trail first behind the animal). Scale the clip speed for other speeds.\n\n**Key times:** `fire` key 0.08 s (the flash: spawn the ball at `fx_muzzle`); the gun jumps back 10.7 u (30 cm) by 0.4 s with a hop and wheel roll, settles, and the crew run it back into battery from 1.5 s to 2.4 s. `reload` key 2.4 s (loaded; the barrel is levelled for loading 0.5-2.4 s, then relaid). `aim` loops an elevation sweep. `damaged` 0.7 s shudder with a wobbling left wheel. `destroyed` holds: the right wheel breaks off and falls flat, the carriage drops onto its broken side, the barrel tips off its trunnions.\n\n**Props:** rammer and powder ladle for the crew are separate files in `cannon_rammer/`.\n\n| clip | length (s) | loop |\n|---|---|---|\n| `idle` | 4 | loop |\n| `move` | 3.442 | loop |\n| `move_towed` | 3.442 | loop |\n| `fire` | 2.4 | once |\n| `reload` | 3 | once |\n| `aim` | 3 | loop |\n| `damaged` | 0.7 | once |\n| `destroyed` | 1.6 | hold |\n\n## Attachment and effect points (empty groups)\n\n- `fx_muzzle` at (0, 26, -38.2)\n- `slot_muzzle` at (0, 26, -38.2)\n- `slot_hitch` at (0, 3.5, 34)\n- `slot_crew_1` at (6, 0, -71)\n- `slot_crew_2` at (-12, 0, 19)"}