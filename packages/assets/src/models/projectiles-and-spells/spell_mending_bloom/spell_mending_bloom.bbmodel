ing_bloom.png","name":"spell_mending_bloom.png","folder":"","namespace":"","id":"0","width":64,"height":64,"uv_width":64,"uv_height":64,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"13c17d38-0850-519a-8d4c-cb08291dece1","relative_path":"spell_mending_bloom.png","source":"data:image/png;base64,"}],"animations":[{"uuid":"db7bd152-1e47-55b9-ac64-5ad5f41f0807","name":"bloom","loop":"once","override":false,"length":0.8,"snapping":24,"selected":false,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"799a0514-29ee-5e28-92ca-8c6d9fbf10ae":{"name":"bloom","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":0.0,"y":-8.0,"z":0.0}],"uuid":"f440c309-4910-58ee-b7e9-2a5b29175700","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":0.0,"y":1.0,"z":0.0}],"uuid":"9dd1a63b-17f3-54a7-b83d-72a25d6727ec","time":0.55,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"b92a0172-c624-51b3-8261-d13e5a8ce8d4","time":0.8,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":-30.0,"z":0.0}],"uuid":"22a8bc5d-5bd1-5d71-9eed-c6f21dd6e378","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"be61a2dc-f524-5faa-9ea2-6c74770f8ca6","time":0.8,"color":-1,"interpolation":"catmullrom"}]}}},{"uuid":"8c211272-e805-51fb-b9d3-cdb95fc7888d","name":"fade","loop":"once","override":false,"length":0.8,"snapping":24,"selected":false,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"799a0514-29ee-5e28-92ca-8c6d9fbf10ae":{"name":"bloom","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"4bc7875f-b8c2-5e65-8d00-8014df28761d","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":0.0,"y":-8.0,"z":0.0}],"uuid":"2bc414d6-0ac2-5614-a882-9e8727b1ee7c","time":0.8,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"# spell_mending_bloom\n\nGrovesinger mending bloom: a patch of flowers springing up in a circle (radius 40 u, 2.3 m across) round the healed allies.\n\n- Bounds (first set): x -45..45, y 0..7, z -45..45 units (2.52 x 0.21 x 2.52 m). Origin at the base centre, front faces -Z.\n- Texture: 64 x 64, 1 px per unit, square pixels, nearest filtering; every visible face has its own region painted with its material at world position (identical faces share one). No cube is cut to fit the texture.\n- Cubes: 148.\n\n## Hit box\n\n- 90 x 7 x 90 (w x h x d), centred at x 0, z 0\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `bloom` | 0.8 | once | the flowers spring up out of the ground with a turn and settle |\n| `fade` | 0.8 | once | flowers sink back into the ground |\n\n- Glowing cubes (`glow_*`): glow_heart0, glow_heart1, glow_heart10, glow_heart11, glow_heart12, glow_heart13, glow_heart14, glow_heart15, glow_heart16, glow_heart17, glow_heart18, glow_heart19 ...\n\n## Notes\n\n- Bright simple glowing shapes; every lit cube is named `glow_*` (flat colours; the game may scale, spin and fade them). No particles or lights in the file.\n"}