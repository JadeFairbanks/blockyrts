58ea-82a0-16eefb7a7421","time":1.1,"color":-1,"interpolation":"linear"},{"channel":"position","data_points":[{"x":0,"y":0,"z":0}],"uuid":"d44cc453-2595-5dcc-9af6-fa59fb6f31f0","time":1.5,"color":-1,"interpolation":"linear"}]},"2302fe6a-2e2e-5712-a351-a7f4d9892d00":{"name":"puff_23","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":0,"y":0,"z":0}],"uuid":"4cb7f3c4-fc5c-57f7-ad0a-2ab24bd73b4e","time":0.0,"color":-1,"interpolation":"linear"},{"channel":"position","data_points":[{"x":0,"y":1.5,"z":0}],"uuid":"c1be8317-7a21-5779-8676-87491cfcc99e","time":0.4,"color":-1,"interpolation":"linear"},{"channel":"position","data_points":[{"x":0,"y":-0.5,"z":0}],"uuid":"58ee0202-99d3-5a39-90fb-c632466ec4d1","time":0.8,"color":-1,"interpolation":"linear"},{"channel":"position","data_points":[{"x":0,"y":1.2,"z":0}],"uuid":"64953c7f-f531-5404-a17b-c1ee4ed01436","time":1.2,"color":-1,"interpolation":"linear"},{"channel":"position","data_points":[{"x":0,"y":0,"z":0}],"uuid":"b3427f2d-5e50-5531-97bd-886484e80b38","time":1.5,"color":-1,"interpolation":"linear"}]}}}],"description":"# spell_crown_of_night\n\nMorvath's Crown of night (puts out every light within 30 m): a black ring of smoke with a faint violet underglow at its leading edge that rolls outward along the ground from him. Lights go dark as it passes them. At rest the ring has a radius of 16 u.\n\n- Bounds (first set): x -20..20, y 0..6.5, z -20..20 units (1.1 x 0.18 x 1.1 m) at rest; 30 m radius and about 16 u high at the end of `spread`. Origin at the base centre, front faces -Z.\n- Texture: 16 x 16, 1 px per unit, square pixels, nearest filtering; every visible face has its own region painted with its material (identical faces share one). No cube is cut to fit the texture.\n- Cubes: 72.\n\n## Hit box\n\n- none (an effect; the game puts out lights as the ring's radius passes them: radius = 16 u x the `ring` bone's x scale)\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `spread` | 1.5 | once | the `ring` bone widens in x and z from 0.5x to 66.75x (radius 8 u to 1068 u = 30 m), fast at first (12x at 0.3 s, 40x at 0.8 s), and grows to 2.5x taller; the 24 puffs bob up and down out of step so the smoke seems to churn and roll; it ends at full size (the game fades it) |\n\n- The ring is 24 overlapping puff segments, each turned round Y by a holder group `turn_<n>` (15 degree steps), so no cube is rotated. Stretching the `ring` bone in x and z keeps the ring closed at every size; the band of smoke widens with it (about 4 m wide at 30 m), which reads as a rolling wall of smoke from above.\n- Glowing cubes (`glow_*`): glow_ember_0 to glow_ember_23 (the violet edge, so the ring reads in the dark it makes).\n\n## Notes\n\n- Bright simple shapes; every lit cube is named `glow_*` (flat colours; the game may scale, spin and fade them). No particles or lights in the file.\n- Made by the model thread (review of batch 2): the bot's batches left this wishlist entry out.\n"}