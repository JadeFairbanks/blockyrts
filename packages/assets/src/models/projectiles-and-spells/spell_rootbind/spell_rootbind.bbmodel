atmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-35.0}],"uuid":"42d92a76-c5aa-5bae-91e4-6ebc625ef35a","time":1,"color":-1,"interpolation":"catmullrom"}]},"4508f582-94f9-5c0b-afa2-cad50da84da8":{"name":"root_3","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"84b05395-3fe8-5227-bfb7-0e34d928059f","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-20.0}],"uuid":"1d6bf806-9dc0-52ff-8bb2-174747449dcd","time":0.5,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-35.0}],"uuid":"3b0e0af6-0592-582b-9ce6-5eadd98880cf","time":1,"color":-1,"interpolation":"catmullrom"}]},"ed77c8f9-4dde-500e-aae7-10b9ef163b7c":{"name":"root_4","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"17b05386-d709-5f15-80c1-fff74dbecf96","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-20.0}],"uuid":"388be011-387d-5cb1-8af2-c12f2f66f99c","time":0.5,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-35.0}],"uuid":"604da226-567d-52ae-bc33-4cb1f8607182","time":1,"color":-1,"interpolation":"catmullrom"}]},"915dbcc6-b43f-56cf-a487-7394d4b79425":{"name":"root_5","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"12686c2b-fb4a-509b-a3fe-55f288b6bd34","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-20.0}],"uuid":"841d0c17-7257-55e7-9d5a-5fea6a4745a4","time":0.5,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-35.0}],"uuid":"77612307-5f80-538c-b192-453b5520ef9d","time":1,"color":-1,"interpolation":"catmullrom"}]},"22deb7a2-b935-587f-86b0-f8b591b4f9a8":{"name":"roots","type":"bone","keyframes":[{"channel":"position","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"11bf7742-2768-5068-8134-09c6ea686690","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"a1c7b5c2-c546-5317-aaff-69ba16395d43","time":0.4,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":0.0,"y":-24.0,"z":0.0}],"uuid":"5cde1fba-9d9a-5d15-b1ca-5643db4c71b8","time":1,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"# spell_rootbind\n\nGrovesinger rootbind: roots that burst out of the ground and wrap a target's legs (to about 26 u high, radius 9 u). Centred on the target.\n\n- Bounds (first set): x -12..14, y -1..26, z -12..12 units (0.73 x 0.77 x 0.68 m). Origin at the base centre, front faces -Z.\n- Texture: 32 x 64, 1 px per unit, square pixels, nearest filtering; every visible face has its own region painted with its material at world position (identical faces share one). No cube is cut to fit the texture.\n- Cubes: 44.\n\n## Hit box\n\n- 26 x 27 x 24 (w x h x d), centred at x 1, z 0\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `burst` | 0.5 | once | roots shoot up out of the ground (from y -26) and snap closed round the legs |\n| `hold` | 1.2 | loop | roots squeeze and creak (small twist) |\n| `wither` | 1.0 | once | roots slacken, fall outward and sink back into the ground |\n\n- Glowing cubes (`glow_*`): glow_root0_vein, glow_root1_vein, glow_root2_vein, glow_root3_vein, glow_root4_vein, glow_root5_vein\n\n## Notes\n\n- Bright simple glowing shapes; every lit cube is named `glow_*` (flat colours; the game may scale, spin and fade them). No particles or lights in the file.\n"}