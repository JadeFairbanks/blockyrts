me":"skirt_upper","box_uv":false,"rescale":false,"locked":false,"render_order":"default","allow_mirror_modeling":true,"from":[-5.75,25.9264,-3.75],"to":[5.75,33.9264,3.75],"autouv":0,"color":0,"origin":[0.0,34.9264,0.0],"faces":{"north":{"uv":[24.0,8.0,36.0,16.0],"texture":0},"east":{"uv":[36.0,8.0,44.0,16.0],"texture":0},"south":{"uv":[44.0,8.0,56.0,16.0],"texture":0},"west":{"uv":[16.0,8.0,24.0,16.0],"texture":0},"up":{"uv":[24.0,0.0,36.0,8.0],"texture":0},"down":{"uv":[36.0,0.0,48.0,8.0],"texture":0}},"type":"cube","uuid":"ae8c9bbc-1a35-5710-beae-47c012e909c2"},{"name":"skirt_hem","box_uv":false,"rescale":false,"locked":false,"render_order":"default","allow_mirror_modeling":true,"from":[-6.75,23.4264,-4.75],"to":[6.75,26.9264,4.75],"autouv":0,"color":0,"origin":[0.0,34.9264,0.0],"faces":{"north":{"uv":[10.0,28.0,24.0,32.0],"texture":0},"east":{"uv":[24.0,28.0,34.0,32.0],"texture":0},"south":{"uv":[34.0,28.0,48.0,32.0],"texture":0},"west":{"uv":[0.0,28.0,10.0,32.0],"texture":0},"up":{"uv":[10.0,18.0,24.0,28.0],"texture":0},"down":{"uv":[24.0,18.0,38.0,28.0],"texture":0}},"type":"cube","uuid":"658b6fad-17dd-5c36-bf3b-0542dc0dfc6f"},{"name":"head","box_uv":false,"rescale":false,"locked":false,"render_order":"default","allow_mirror_modeling":true,"from":[-4.0,52.9264,-4.0],"to":[4.0,60.9264,4.0],"autouv":0,"color":0,"origin":[0.0,51.4264,0.0],"faces":{"north":{"uv":[64.0,8.0,72.0,16.0],"texture":0},"east":{"uv":[72.0,8.0,80.0,16.0],"texture":0},"south":{"uv":[80.0,8.0,88.0,16.0],"texture":0},"west":{"uv":[56.0,8.0,64.0,16.0],"texture":0},"up":{"uv":[64.0,0.0,72.0,8.0],"texture":0},"down":{"uv":[72.0,0.0,80.0,8.0],"texture":0}},"type":"cube","uuid":"d4f60998-7d4a-579e-94bb-a426ab6fbaed"},{"name":"eye_r","box_uv":false,"rescale":false,"locked":false,"render_order":"default","allow_mirror_modeling":true,"from":[0.5,54.9264,-4.25],"to":[3.5,57.9264,-4.0],"autouv":0,"color":0,"origin":[0.0,51.4264,0.0],"faces":{"north":{"uv":[67.0,54.0,70.0,57.0],"texture":0},"east":{"uv"