8d-5e55-8010-f1a8bbbcd7df","574b5e24-c1b1-58fb-b3ec-f14d54783005","f8c0f3c2-3adf-5c6b-856c-5e88efcb7d59","c0f9b8be-a429-58b8-9806-5d10816a58b0","a8bbed82-cfe3-5b63-9ad9-66b65a8c1690","147a755f-c759-5a9a-8067-4e0ff3a94964","8d92fd8e-7dcd-5e96-af34-cb0442925bf5","cace470a-99a4-5ed0-97e4-a89bac653996","965acfe2-d09c-5d6c-af9f-174da63bc8d3","0f79e47b-cbd2-594d-bef7-ca3737329f8b","ca306877-3e52-576e-b223-ec318b407e79"]}]}],"textures":[{"path":"crop_flax.png","name":"crop_flax.png","folder":"","namespace":"","id":"0","width":64,"height":64,"uv_width":64,"uv_height":64,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"5c7388e8-b620-56b1-b832-ed996382f936","relative_path":"crop_flax.png","source":"data:image/png;base64,"}],"animations":[],"description":"# crop_flax\n\nFlax row: thin stems with blue flowers, about 80 cm (28 u) when ripe.\n\n- Bounds (first set): x -8..8, y 0..3, z -6..6 units (0.45 x 0.09 x 0.34 m). Origin at the base centre, front faces -Z.\n- Texture: 64 x 64, 1 px per unit, square pixels, nearest filtering; every visible face has its own region painted with its material at world position (identical faces share one). No cube is cut to fit the texture.\n- Cubes: 70.\n\n## Hit box\n\n- 16 x 3 x 12 (w x h x d), centred at x 0, z 0\n\n## State group sets (children of `root`; show exactly one)\n\n- `seeded` (visible by default): dark tilled ridge with seed holes\n- `sprout`: first green shoots\n- `growing`: half-grown green plants\n- `ripe`: thin stems topped with blue flowers\n- `harvested`: after harvest\n\n## Notes\n\n- One row segment, 1 column (16 u) long along X, centred on the origin; tile rows side by side every 16 u in Z for a field.\n"}