{"meta":{"format_version":"5.0","model_format":"free","box_uv":false},"name":"rock_coal","model_identifier":"rock_coal","visible_box":[1,1,0],"variable_placeholders":"","multi_file_ruleset":"","variable_placeholder_buttons":[],"timeline_setups":[],"unhandled_root_fields":{"description":"# rock_coal\n\nCoal rock (remade in Patch 5): a grey rock of overlapping blocks with twelve black glossy coal chunks of different sizes and angles, each sunk at least a third into the rock.\n\n- Bounds (first set): x -47..45, y 0..45, z -38..38 units. Origin at the base centre, front faces -Z.\n- Texture: 256 x 256, 1 px per unit, flat pixel-art tones per material.\n- Cubes: 31 (full 24, depleted 7).\n- Clips: `hit`.\n\n## State group sets (children of `root`; show exactly one)\n\n- `full` (visible by default)\n- `depleted`: a low broken stump with rubble and one coal fleck"},"resolution":{"width":256,"height":256},"elements":[{"name":"rock_base","box_uv":false,"render_order":"default","locked":false,"export":true,"scope":0,"allow_mirror_modeling":true,"from":[-30,0,-22],"to":[30,26,22],"autouv":0,"color":3,"origin":[0,0,0],"faces":{"north":{"uv":[92,44,152,70],"texture":0},"east":{"uv":[212,44,256,70],"texture":0},"south":{"uv":[152,44,212,70],"texture":0},"west":{"uv":[0,78,44,104],"texture":0},"up":{"uv":[0,0,60,44],"texture":0},"down":{"uv":[60,0,120,44],"texture":0}},"type":"cube","uuid":"8c1a546b-2fa9-6ff2-0e53-6427c2f5c821"},{"name":"rock_mid#7a7872","box_uv":false,"render_order":"default","locked":false,"export":true,"scope":0,"allow_mirror_modeling":true,"from":[-24,20,-18],"to":[22,36,16],"autouv":0,"color":0,"origin":[0,0,0],"faces":{"north":{"uv":[0,122,46,138],"texture":0},"east":{"uv":[92,122,126,138],"texture":0},"south":{"uv":[46,122,92,138],"texture":0},"west":{"uv":[126,122,160,138],"texture":0},"up":{"uv":[0,44,46,78],"texture":0},"down":{"uv":[46,44,92,78],"texture":0}},"type":"cube","uuid":"78d46301-f52b-e4e8-5050-1e9930fa6379"},{"name":"rock_top#8c8a84","box_uv"