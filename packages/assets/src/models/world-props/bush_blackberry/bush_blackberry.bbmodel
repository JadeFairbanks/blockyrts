{"meta":{"format_version":"5.0","model_format":"free","box_uv":false},"name":"bush_blackberry","model_identifier":"bush_blackberry","visible_box":[1,1,0],"variable_placeholders":"","multi_file_ruleset":"","variable_placeholder_buttons":[],"timeline_setups":[],"unhandled_root_fields":{"description":"# bush_blackberry\n\nBlackberry bush (Patch 5): a low, wide bramble of arching thorny red-brown canes and dark green leaves, dotted with small black berries and a few unripe red ones.\n\n- Bounds (first set): x -22..22, y 0..30, z -22..20 units. Origin at the base centre, front faces -Z.\n- Texture: 256 x 128, 1 px per unit, flat pixel-art tones per material.\n- Cubes: 136 (full 88, picked 48).\n\n## State group sets (children of `root`; show exactly one)\n\n- `full` (visible by default)\n- `picked`: the bramble with no berries (shown until they grow back)"},"resolution":{"width":256,"height":128},"elements":[{"name":"log_stem_base#4a3228","box_uv":false,"render_order":"default","locked":false,"export":true,"scope":0,"allow_mirror_modeling":true,"from":[-2.5,0,-2.5],"to":[2.5,6,2.5],"autouv":0,"color":0,"origin":[0,3,0],"faces":{"north":{"uv":[168,65,173,71],"texture":0},"east":{"uv":[173,65,178,71],"texture":0},"south":{"uv":[178,65,183,71],"texture":0},"west":{"uv":[183,65,188,71],"texture":0},"up":{"uv":[208,65,213,70],"texture":0},"down":{"uv":[213,65,218,70],"texture":0}},"type":"cube","uuid":"b6e35e2d-80fd-2bbc-e356-f6b778c661a0"},{"name":"leaf_cluster_0#2f5a2a","box_uv":false,"render_order":"default","locked":false,"export":true,"scope":0,"allow_mirror_modeling":true,"from":[-7.5,3,-7.5],"to":[7.5,16,7.5],"autouv":0,"color":5,"origin":[0,9.5,0],"faces":{"north":{"uv":[76,0,91,13],"texture":0},"east":{"uv":[91,0,106,13],"texture":0},"south":{"uv":[106,0,121,13],"texture":0},"west":{"uv":[121,0,136,13],"texture":0},"up":{"uv":[0,0,15,15],"texture":0},"down":{"uv":[15,0,30,15],"texture":0}},"type":"cube","uuid":"186b4c8c-2457-645e-86c0-d5333483df3c"},{"name":"leaf_clu