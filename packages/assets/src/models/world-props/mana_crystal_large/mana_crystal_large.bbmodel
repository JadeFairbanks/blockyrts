ad-a853-5c4dc366913b","5dbf864d-4453-ff40-5fc0-ca0a1a02fdce","997f3ae8-e343-bbd2-6d45-61555fa0222d","8c196e3f-68a7-b86c-77a0-ecc0cc4da80c","dbdd2dd0-ca5b-06c9-546e-e1f054607296","ca3562c4-9cec-8de8-af5d-bb732484bafa","375430ee-1404-5859-1be9-3a97e8d9f4b5","90ac4a46-5d61-7494-d200-bc5ab4ec5c84"],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},{"name":"slot_guardian","uuid":"8102c17b-286f-c31b-8181-488cb923dd3c","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[0,106,0],"rotation":[0,0,0],"color":0,"children":[],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false},{"name":"fx_glow","uuid":"bf7f6b1a-d760-169e-7292-8b4d7e44383d","export":true,"locked":false,"scope":0,"selected":false,"visibility":true,"_static":{"properties":{},"temp_data":{}},"origin":[0,20,0],"rotation":[0,0,0],"color":0,"children":[],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"textures":[{"name":"mana_crystal_large.png","path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":512,"height":256,"uv_width":512,"uv_height":256,"particle":false,"use_as_default":false,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"08b0975f-b076-e744-87bc-a533f66f8ad2","source":"data:image/png;base64,","relative_path":""}],"description":"# mana_crystal_large\n\nLarge mana crystal node (Patch 5), 40 crystals' worth, guarded by a Fae Guardian: a broad base of black volcanic rock with a tall central cyan crystal about 94 u (2.6 m) high, eight leaning smaller crystals round it and glowing shards on the ground. Crystals are `glow_*` cubes in the mana crystal's cyan with pale cores and tips, like `mana_crystal_node`.\n\n- Origin at the base centre, front faces -Z. Bounds (full): x -82..80, y -2..94, z -62..60 units (the base sinks 2 u).\n\n## State group sets (children of `root`; show exactly one)\n\n- `full` (visible by default)\n- `depleted`: the rock base with broken crystal stubs and a fallen shard\n\n## Attachment and effect points (empty groups)\n\n- `slot_guardian` at (0, 106, 0): where the Fae Guardian hovers, above the central crystal's tip.\n- `fx_glow` at (0, 20, 0): the base of the central crystal."}