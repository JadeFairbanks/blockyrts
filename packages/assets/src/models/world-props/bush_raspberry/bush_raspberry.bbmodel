{"meta":{"format_version":"5.0","model_format":"free","box_uv":false},"name":"bush_raspberry","model_identifier":"bush_raspberry","visible_box":[1,1,0],"variable_placeholders":"","multi_file_ruleset":"","variable_placeholder_buttons":[],"timeline_setups":[],"unhandled_root_fields":{"description":"# bush_raspberry\n\nRaspberry bush (Patch 5): an open, upright clump of canes with pale green leaves and hanging red-pink berries.\n\n- Bounds (first set): x -17..17, y 0..35, z -17..16 units. Origin at the base centre, front faces -Z.\n- Texture: 128 x 128, 1 px per unit, flat pixel-art tones per material.\n- Cubes: 140 (full 88, picked 52).\n\n## State group sets (children of `root`; show exactly one)\n\n- `full` (visible by default)\n- `picked`: the canes with no berries"},"resolution":{"width":128,"height":128},"elements":[{"name":"log_stub_a#6a4a3a","box_uv":false,"render_order":"default","locked":false,"export":true,"scope":0,"allow_mirror_modeling":true,"from":[-2,0,-2],"to":[2,5,2],"autouv":0,"color":4,"origin":[0,2.5,0],"faces":{"north":{"uv":[108,47,112,52],"texture":0},"east":{"uv":[112,47,116,52],"texture":0},"south":{"uv":[116,47,120,52],"texture":0},"west":{"uv":[120,47,124,52],"texture":0},"up":{"uv":[96,62,100,66],"texture":0},"down":{"uv":[100,62,104,66],"texture":0}},"type":"cube","uuid":"60ada992-b184-b0e5-555d-395a927cb128"},{"name":"leaf_ground#4f7e34","box_uv":false,"render_order":"default","locked":false,"export":true,"scope":0,"allow_mirror_modeling":true,"from":[-4.5,0.34,-6],"to":[2.5,2.34,0],"autouv":0,"color":2,"origin":[-1,1.34,-3],"faces":{"north":{"uv":[72,72,79,74],"texture":0},"east":{"uv":[100,72,106,74],"texture":0},"south":{"uv":[79,72,86,74],"texture":0},"west":{"uv":[106,72,112,74],"texture":0},"up":{"uv":[96,18,103,24],"texture":0},"down":{"uv":[103,18,110,24],"texture":0}},"type":"cube","uuid":"b8026dc9-5c40-d881-c15d-ff023c8bdc60"},{"name":"leaf_ground#5a8a3a","box_uv":false,"render_order":"default","locked":false,"export":true,"scop