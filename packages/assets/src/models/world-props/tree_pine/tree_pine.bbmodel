42c-05f14d6d119f","time":1.95,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"0ce973b3-998b-5b8e-9674-6c75c1c6c7bc","time":2.2,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"0a027f1c-487f-59a2-96dc-718a74769f27","time":2.5,"color":-1,"interpolation":"catmullrom"}]},"54be4bea-223f-513f-8ddc-d42e24eabf77":{"name":"canopy_2","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"8d52ac6d-7e50-5285-a3c2-2016883c1412","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"673488d0-ec85-5339-8fce-4aa363ea9a5b","time":1.45,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-4.0}],"uuid":"a6d3c980-660c-54fb-85dd-c87d2c541350","time":1.55,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":3.0}],"uuid":"0af05a50-fcd0-55dc-9610-da32c6d16f7f","time":1.75,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-1.5}],"uuid":"0febde60-e4c9-5a39-969f-db8ba1569e2b","time":1.95,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"9515d1fc-7532-591a-8a9b-963e14b4796b","time":2.2,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"6ece68a1-8ad1-5acb-8e52-00ae78a2cb1a","time":2.5,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"# tree_pine\n\nReference pine: straight pale-brown trunk, high crown of dark layered tiers, about 10 m (356 u).\n\n- Bounds (first set): x -50..46, y 0..359, z -41..45 units (2.70 x 10.10 x 2.43 m). Origin at the base centre, front faces -Z.\n- Texture: 256 x 1024, 1 px per unit, square pixels, nearest filtering; every visible face has its own region painted with its material at world position (identical faces share one). No cube is cut to fit the texture.\n- Cubes: 19.\n\n## Hit box\n\n- trunk: 14 x 356 x 14 at the origin (the solid, blocking part)\n- canopy: see bounds; units walk under it\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `rustle` | 5.0 | loop | canopy bones sway very slightly (trunk still) |\n| `hit` | 0.4 | once | canopy shivers after an axe strike |\n| `fall` | 2.5 | once | whole `tree` group tips over sideways onto +X about the trunk base edge, hits at 1.5 s, bounces once, settles by 2.1 s; canopy whips on impact |\n\n## Notes\n\n- `rustle` and `hit` move only the canopy groups; `fall` rotates the `tree` group (pivot on the trunk base edge on +X), so the trunk lies along +X after 1.5 s (it stops short of flat where the crown meets the ground). Swap to the `_stump` model (and spawn the `_log_pile`) once it has settled.\n"}