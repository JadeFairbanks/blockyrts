84f3840","24812938-c2b8-5e08-9c89-4db3471a2202","1427f6e6-bca6-59a5-a207-5719eb9bb608","a8becd48-b7db-5aa5-baf0-a770745fe6ef","40976d3f-2a9c-54d5-ba5d-56102032c207","6b3e13e9-b369-5391-b10f-f35e54703e03","5d599cee-6e85-577a-808f-015916c19296","38652618-e819-5718-9e5a-8e8dbfed702b","fd28cd10-c75c-596c-b836-8329ae98327f","3f45881f-5079-5b84-b6ff-a6840f61aed3","55427f27-e747-5642-ada6-05efe32c3494","a4697d91-0292-57b2-85fe-d4162596a719"]}]}],"textures":[{"path":"crop_wheat.png","name":"crop_wheat.png","folder":"","namespace":"","id":"0","width":64,"height":64,"uv_width":64,"uv_height":64,"particle":false,"use_as_default":true,"layers_enabled":false,"sync_to_project":"","render_mode":"default","render_sides":"auto","frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"16081984-9e6d-57d8-bb77-ccb60078c9b2","relative_path":"crop_wheat.png","source":"data:image/png;base64,"}],"animations":[],"description":"# crop_wheat\n\nWheat row: green stalks turning golden, ripe at about 90 cm (32 u) with golden ears.\n\n- Bounds (first set): x -8..8, y 0..3, z -6..6 units (0.45 x 0.09 x 0.34 m). Origin at the base centre, front faces -Z.\n- Texture: 64 x 64, 1 px per unit, square pixels, nearest filtering; every visible face has its own region painted with its material at world position (identical faces share one). No cube is cut to fit the texture.\n- Cubes: 70.\n\n## Hit box\n\n- 16 x 3 x 12 (w x h x d), centred at x 0, z 0\n\n## State group sets (children of `root`; show exactly one)\n\n- `seeded` (visible by default): dark tilled ridge with seed holes\n- `sprout`: first green shoots\n- `growing`: half-grown green plants\n- `ripe`: tall golden stalks with ears\n- `harvested`: after harvest\n\n## Notes\n\n- One row segment, 1 column (16 u) long along X, centred on the origin; tile rows side by side every 16 u in Z for a field.\n"}