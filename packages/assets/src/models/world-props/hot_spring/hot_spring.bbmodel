:[3,6,13.5],"rotation":[0,0,0],"color":0,"children":[],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"reset":false,"shade":true,"mirror_uv":false,"autouv":0,"isOpen":false,"primary_selected":false}],"textures":[{"name":"hot_spring.png","path":"","folder":"","namespace":"","id":"0","group":"","scope":0,"width":256,"height":128,"uv_width":256,"uv_height":128,"particle":false,"use_as_default":false,"layers_enabled":false,"sync_to_project":"","file_format":"png","render_mode":"default","render_sides":"auto","wrap_mode":"limited","pbr_channel":"color","fps":7,"frame_time":1,"frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"a92322f9-554a-d3ef-312e-8a456edf9cf9","source":"data:image/png;base64,","relative_path":""}],"description":"# hot_spring\n\nHot spring (Patch 5): the crust round a hot spring pool: pale yellow-orange mineral crust in rings and terraces, sulphur-capped stones and patches, a glowing bubbling vent and dead twigs. The water itself is drawn by the terrain. `fx_steam_1` to `fx_steam_3` mark where steam rises and `fx_bubble` the vent.\n\n- Bounds (first set): x -44..44, y -1..17, z -32..36 units. Origin at the base centre, front faces -Z.\n- Texture: 256 x 128, 1 px per unit, flat pixel-art tones per material.\n- Cubes: 54 (full 54).\n\n## State group sets\n\n- `full` only (it is never used up)."}