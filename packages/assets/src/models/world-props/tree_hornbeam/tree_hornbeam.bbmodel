.0,"z":-49.28}],"uuid":"4c804924-cbfb-50af-8e86-5fb0cb392f6a","time":1.2,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-77.0}],"uuid":"24251a52-fb58-5945-af1f-9f872eaa5b2a","time":1.5,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-70.0}],"uuid":"d9838663-7371-5116-a19b-29bcefad771b","time":1.7,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-77.0}],"uuid":"3ff4ec97-2590-5faf-afef-8046bd423382","time":1.9,"color":-1,"interpolation":"linear"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-77.0}],"uuid":"e98c69ed-1dac-53c5-8271-4e43b42bff02","time":2.5,"color":-1,"interpolation":"linear"}]},"3bcdc017-e253-5663-8ddc-d3cd8c7ae852":{"name":"canopy_0","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"7b50ab5d-1338-59cf-b6bc-714ec5df3ddf","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"f3b96cad-76a6-5071-910e-fd43d52337eb","time":1.45,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-4.0}],"uuid":"5c9d039b-179e-54d1-a1c6-9104950caf63","time":1.55,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":3.0}],"uuid":"fd6410e9-5124-5477-91d5-f31391d52de7","time":1.75,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":-1.5}],"uuid":"e16ea1ba-4d62-548f-9611-1887bb315d25","time":1.95,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"c12c60a4-d480-5145-8b6f-aae56e5b4662","time":2.2,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"2c6deeb3-3c48-5493-b1cb-44f2bda7a08e","time":2.5,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"# tree_hornbeam\n\nReference hornbeam: grey fluted trunk, rounded crown, about 7.5 m (267 u).\n\n- Bounds (first set): x -68..69, y 0..264, z -69..67 units (3.85 x 7.42 x 3.83 m). Origin at the base centre, front faces -Z.\n- Texture: 512 x 512, 1 px per unit, square pixels, nearest filtering; every visible face has its own region painted with its material at world position (identical faces share one). No cube is cut to fit the texture.\n- Cubes: 18.\n\n## Hit box\n\n- trunk: 14 x 267 x 14 at the origin (the solid, blocking part)\n- canopy: see bounds; units walk under it\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `rustle` | 5.0 | loop | canopy bones sway very slightly (trunk still) |\n| `hit` | 0.4 | once | canopy shivers after an axe strike |\n| `fall` | 2.5 | once | whole `tree` group tips over sideways onto +X about the trunk base edge, hits at 1.5 s, bounces once, settles by 2.1 s; canopy whips on impact |\n\n## Notes\n\n- `rustle` and `hit` move only the canopy groups; `fall` rotates the `tree` group (pivot on the trunk base edge on +X), so the trunk lies along +X after 1.5 s (it stops short of flat where the crown meets the ground). Swap to the `_stump` model (and spawn the `_log_pile`) once it has settled.\n"}