frame_order_type":"loop","frame_order":"","frame_interpolate":false,"visible":true,"internal":true,"saved":true,"uuid":"1b169c06-6eab-51de-bed0-086600c08d4d","source":"data:image/png;base64,","relative_path":""}],"animations":[{"uuid":"db953f2c-e2f9-5ce5-be44-347017817dab","name":"flicker","loop":"loop","override":false,"length":0.8,"snapping":24,"selected":false,"group_name":"","scope":0,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"801830c5-cf42-506a-a5f1-784d781b072e":{"name":"flame","type":"bone","rotation_global":false,"quaternion_interpolation":false,"keyframes":[{"channel":"position","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"76a05e81-1060-5bb0-b1e3-da030f2f270d","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"-0.3","y":"0.5","z":"0"}],"uuid":"5d0b91bd-fcfd-5af9-b2ed-ae4ff8216e26","time":0.2,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"0.25","y":"-0.15","z":"0.15"}],"uuid":"912eb362-98c5-51e7-be01-0783517ed250","time":0.4,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"-0.15","y":"0.3","z":"-0.15"}],"uuid":"5ebc3b01-8ff7-5582-a667-afd2a419cbfd","time":0.6,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"d3e15772-72d6-5c92-8196-b9a11b0f6086","time":0.8,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"# torch_post\n\nTorch post: a wooden post about 1.8 m (64 u) tall with an iron cup at the top.\n\nRemade in Patch 5 with a new look: a carved post with collars and notches on a cobble and stone footing, rope wraps, a player-colour ribbon, and an iron cup in a cage holding the flame.\n\n- Bounds (first set): x -4..4, y 0..75, z -4..4 units (0.25 x 2.11 x 0.25 m). Origin at the base centre, front faces -Z.\n- Texture: 128 x 128, 1 px per unit, square pixels, nearest filtering, flat pixel-art tones per material.\n- Cubes: 37, all in `finished`; no hidden state sets (the construction and ruined sets and the damaged/abandoned texture variants were removed in the Patch 5 remake; the game draws none of them for buildings).\n\n## Hit box\n\n- 8 x 64 x 8 post\n\n## Clips\n\n- `flicker` (0.8 s, loop): the flame flickers.\n\n## Attachment and effect points (empty groups)\n\n- `fx_flame` at (0, 68, 0)"}