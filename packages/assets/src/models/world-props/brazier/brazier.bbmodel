b9bf1","time":0.0,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":0.3,"y":0.5,"z":0.0}],"uuid":"6cbba65d-4ba5-54cc-979c-7a3afeb098c6","time":0.2,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":-0.25,"y":-0.15,"z":0.15}],"uuid":"cb5d3eae-f89e-5d7c-84f5-bd556d5afcc9","time":0.4,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":0.15,"y":0.3,"z":-0.15}],"uuid":"24003542-96ac-5732-a1a7-d330a67e8af0","time":0.6,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":0.0,"y":0.0,"z":0.0}],"uuid":"f7333843-7371-5cc7-b51f-274371b1b4a7","time":0.8,"color":-1,"interpolation":"catmullrom"}]}}}],"description":"# brazier\n\nBrazier: an iron bowl on three legs, about 1 m (34 u) tall.\n\n- Bounds (first set): x -11..11, y 0..51, z -10..13 units (0.62 x 1.45 x 0.64 m). Origin at the base centre, front faces -Z.\n- Texture: 64 x 64, 1 px per unit, square pixels, nearest filtering; every visible face has its own region painted with its material at world position (identical faces share one). No cube is cut to fit the texture.\n- Cubes: 19.\n\n## Hit box\n\n- 22 x 34 x 22 centred on the origin\n\n## State group sets (children of `root`; show exactly one)\n\n- `lit` (visible by default): burning coals and flames\n- `unlit`: cold coal in the bowl\n\n## Clips\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `flicker` | 0.8 | loop | the flame group `flame` jitters (the light flicker itself is the game's) |\n\n## Attachment and effect points (empty groups)\n\n- `fx_flame` at (0, 46, 0)\n- `fx_smoke` at (0, 54, 0)\n\n- Glowing cubes (`glow_*`): glow_coals_l, glow_flame, glow_flame_1, glow_flame_1_1, glow_flame_1_2, glow_flame_2, glow_flame_tongue\n"}