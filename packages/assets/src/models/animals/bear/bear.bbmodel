db2-aab2-2dad-87d85300ee23","time":1.75,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"13b11f8f-36f1-c66e-c83a-cb460b1093ce","time":2,"color":-1,"interpolation":"catmullrom"}]},"656f956b-1727-581a-af42-4d14b95f405b":{"name":"leg_front_upper_r","type":"bone","rotation_global":false,"quaternion_interpolation":false},"89debde0-36c8-5840-a474-5a4922c417a7":{"name":"leg_front_lower_r","type":"bone","rotation_global":false,"quaternion_interpolation":false},"7f670e43-f19e-52ee-a4e6-4babde3c9abf":{"name":"foot_front_r","type":"bone","rotation_global":false,"quaternion_interpolation":false},"0efb4fba-9f15-5f4e-86bd-71778f224ccd":{"name":"leg_front_upper_l","type":"bone","rotation_global":false,"quaternion_interpolation":false},"61cceb23-8e66-56c6-aaf5-1ea8deeab74c":{"name":"leg_front_lower_l","type":"bone","rotation_global":false,"quaternion_interpolation":false},"0a7e8776-5d85-5f8c-89ea-4cecec9791a5":{"name":"foot_front_l","type":"bone","rotation_global":false,"quaternion_interpolation":false},"ec340842-3433-5271-a94a-57401da14ba2":{"name":"leg_back_upper_r","type":"bone","rotation_global":false,"quaternion_interpolation":false},"0cf786eb-e16c-5ac6-97a2-8b2d62a371db":{"name":"leg_back_lower_r","type":"bone","rotation_global":false,"quaternion_interpolation":false},"3d6c2a0b-f476-5bae-bb3d-6d5f95801989":{"name":"foot_back_r","type":"bone","rotation_global":false,"quaternion_interpolation":false},"c073946c-e79f-5a69-8a00-e5dbe962c9ca":{"name":"leg_back_upper_l","type":"bone","rotation_global":false,"quaternion_interpolation":false},"aa56aeb0-2bc6-5cd4-afb0-229d4bab7a94":{"name":"leg_back_lower_l","type":"bone","rotation_global":false,"quaternion_interpolation":false},"ab6b556d-b14c-537d-89e6-41cc63462088":{"name":"foot_back_l","type":"bone","rotation_global":false,"quaternion_interpolation":false}}}],"description":"# bear\n\nBear (B7), 1.3 m at the shoulder hump (46 u), 2.6 m standing (rear_roar reaches about 90 u), about 2.3 m long (64 u body + head).\n\nBig brown bear of the giant forests: heavy barrel body, shoulder hump, short thick neck, broad head with small dark eyes and round ears, separate lower jaw for roar/bite, stubby tail, thick plantigrade legs with heavy paws and pale claws. Quadruped rig: root > body > neck > head > jaw, body > tail_1, four legs (upper, lower, foot).\n\n- Cubes: 22 (all unrotated unless noted). Texture 128x128, 1 px per unit, embedded.\n- Rest bounds (body, no held items): x -11.0..11.0, y 0.0..45.5, z -42.0..25.0 (faces -Z).\n\n## Hit box\n\n- body box 20 x 46 x 64 (w x h x d), centred on x = 0, z = 0, from y = 0\n- rearing: 20 x 92 x 30 around the hind feet\n\n## Clips\n\n| clip | length (s) | loop | notes |\n|---|---|---|---|\n| `idle` | 3.6 | loop | breathing, looking around |\n| `walk` | 0.9 | loop |  |\n| `run` | 0.45 | loop |  |\n| `charge` | 0.414 | loop |  |\n| `swipe` | 1 | once | key 0.46 s: right forepaw sweeps through the target (arc in front, right to left) |\n| `rear_roar` | 2.6 | once | stands up (1.0 s fully upright), roar key 1.0-1.6 s, drops back by 2.6 s |\n| `sniff` | 2.4 | loop | nose to the ground, swinging side to side (loop) |\n| `injured` | 0.6 | once | flinch back from the front |\n| `death` | 1.4 | hold | buckles and rolls onto its right side, holds; rests on y = 0 |\n| `mate` | 2.0 | loop | Patch 5: a gentle nuzzle toward the partner on the model's left (head and neck turn, body sway, tail wag; birds fluff their wings, the hare hops), played by two animals side by side while the game draws hearts over them. |\n\n## Move speeds (in-place cycles; stride matched to these)\n\n- `walk`: 39.1 u/s (1.10 m/s), cycle 0.9 s (4-beat)\n- `run`: 177.8 u/s (5.00 m/s), cycle 0.45 s (bounding gallop)\n- `charge`: 204.4 u/s (5.75 m/s), head low\n\n## Key times\n\n- `swipe`: key 0.46 s: right forepaw sweeps through the target (arc in front, right to left)\n- `rear_roar`: stands up (1.0 s fully upright), roar key 1.0-1.6 s, drops back by 2.6 s\n\n## Attachment points (empty groups, pivot in model units)\n\n\n## Variant textures (same UV layout)\n\n- `bear_cub.png`: young texture (use at half scale): lighter, fluffier, bigger-looking eyes\n\n## Notes\n\n- Legs are straight under the hips at rest; gait clips use IK so the paws stay planted at the designed speed."}