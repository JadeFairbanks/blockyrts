2914-a33b-c85ee3bf61ca","time":0.5,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"9930439e-30a6-1433-446e-04b52f554809","time":1,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"-8"}],"uuid":"5956dd0a-08d1-793a-9ad1-9ba6a1409319","time":1.5,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"a2ddab01-7cf4-9143-2b30-4a05c59164d2","time":2,"color":-1,"interpolation":"catmullrom"}]},"fcf8cb38-969a-5395-944c-c67ffd373ba3":{"name":"leg_upper_l","type":"bone","rotation_global":false,"quaternion_interpolation":false},"81ee638b-e082-54ac-afe3-931d053ab2d9":{"name":"leg_lower_l","type":"bone","rotation_global":false,"quaternion_interpolation":false},"c0b94ad8-ae74-5ae0-8ac3-34127f41cc99":{"name":"foot_l","type":"bone","rotation_global":false,"quaternion_interpolation":false}}}],"description":"# wild_goose\n\nWild goose (Patch 5): a greylag goose, made from `chicken_hen`.\n\nGrey-brown body and wings with paler barring and a darker back, a pale belly and under-tail, a long grey-brown neck, an orange beak with a pale tip and pink-orange legs; about 1.4 times the hen. Every hen bone and clip is kept; the `head` pivot moved to the top of the neck (0, 24, -4.7), so `peck` dips the head but does not reach the ground.\n\n- Cubes: 24. Texture 64x64, 1 px per unit, embedded, flat pixel-art tones per material.\n- Bounds at rest: x -6..6, y 0..28, z -11..12 u.\n- Clips: `idle`, `walk`, `run`, `peck`, `flap`, `sit`, `injured`, `death`.\n\n## Clips (Patch 5 addition)\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `mate` | 2.0 | loop | Patch 5: a gentle nuzzle toward the partner on the model's left (head and neck turn, body sway, tail wag; birds fluff their wings, the hare hops), played by two animals side by side while the game draws hearts over them. |"}