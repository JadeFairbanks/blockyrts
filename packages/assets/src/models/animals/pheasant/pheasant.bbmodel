ff7","time":1.75,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"38760aa2-53ff-8d6f-116d-306a24989e6f","time":2,"color":-1,"interpolation":"catmullrom"}]},"9e6c2d6c-d9d7-58ab-9a70-d41507539241":{"name":"leg_upper_l","type":"bone","rotation_global":false,"quaternion_interpolation":false},"c9c7440c-47f8-5344-9683-45f63d1213f8":{"name":"leg_lower_l","type":"bone","rotation_global":false,"quaternion_interpolation":false},"d7c33e60-0ca6-5f78-b748-84bfd81ff5d0":{"name":"foot_l","type":"bone","rotation_global":false,"quaternion_interpolation":false}}}],"description":"# pheasant\n\nPheasant (Patch 5): a cock pheasant, made from `chicken_rooster`.\n\nA copper-bronze body with dark scale bars, chestnut wings, a dark green glossy head with red face wattles and a white neck ring, and a very long barred tail stepped back and up. Every rooster bone, pivot and clip is kept.\n\n- Cubes: 28. Texture 64x32, 1 px per unit, embedded, flat pixel-art tones per material.\n- Bounds at rest: x -4..4, y 0..16, z -8..22 u.\n- Clips: `idle`, `walk`, `run`, `peck`, `flap`, `sit`, `injured`, `death`.\n\n## Clips (Patch 5 addition)\n\n| clip | length (s) | loop | what moves |\n|---|---|---|---|\n| `mate` | 2.0 | loop | Patch 5: a gentle nuzzle toward the partner on the model's left (head and neck turn, body sway, tail wag; birds fluff their wings, the hare hops), played by two animals side by side while the game draws hearts over them. |"}